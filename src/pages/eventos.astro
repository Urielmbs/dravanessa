---
// src/pages/eventos.astro
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Eventos, Palestras & Congressos | Dra. Vanessa Silveira"
  description="Participações da Dra. Vanessa Silveira em congressos, palestras e eventos científicos de Cirurgia Bucomaxilofacial e DTM."
>
  <Nav />
  <main class="vs-section page-container">
    <div class="vs-container">
      <div class="page-header vs-reveal">
        <span class="vs-badge">Atuação Acadêmica & Científica</span>
        <h1 class="vs-font-display">Eventos, Palestras e Simpósios</h1>
        <p class="page-lead">
          A Dra. Vanessa Silveira participa ativamente de congressos nacionais e internacionais, ministrando palestras sobre DTM, Dor Orofacial e Cirurgia Bucomaxilofacial.
        </p>
      </div>

      <div class="events-grid vs-reveal" data-delay="1">
        <div class="event-card">
          <div class="event-card__tag">Palestra Principal</div>
          <h3>Simpósio de Dor Orofacial & DTM</h3>
          <p class="event-date">Juiz de Fora — MG</p>
          <p class="event-desc">Abordagem multidisciplinar e técnicas minimamente invasivas no tratamento de disfunsões temporomandibulares complexas.</p>
        </div>

        <div class="event-card">
          <div class="event-card__tag">Congresso Científico</div>
          <h3>Congresso Brasileiro de Bucomaxilofacial</h3>
          <p class="event-date">São Paulo — SP</p>
          <p class="event-desc">Apresentação de casos clínicos de cirurgia ortognática com planejamento digital 3D de alta precisão.</p>
        </div>

        <div class="event-card">
          <div class="event-card__tag">Mesa Redonda</div>
          <h3>Jornada de Odontologia Hospitalar</h3>
          <p class="event-date">Belo Horizonte — MG</p>
          <p class="event-desc">Manejo cirúrgico bucomaxilofacial e suporte estomatológico em pacientes oncológicos sob radioterapia.</p>
        </div>
      </div>

      <div class="events-invite vs-reveal" data-delay="2">
        <h2>Convide a Dra. Vanessa para o seu Evento ou Congresso</h2>
        <p>Quer contar com uma palestra técnica e humanizada sobre DTM, Dor Orofacial e Cirurgia Bucomaxilofacial na sua instituição ou evento?</p>
        <a href="/contato" class="vs-btn vs-btn--primary">Fale conosco para convites e agenda</a>
      </div>
    </div>
  </main>
  <Contato />
  <Footer />
</Layout>

<style>
  .page-container {
    padding: calc(var(--space-20) + 2rem) 0 var(--space-16);
    background: var(--color-cream);
    min-height: 80vh;
  }
  .vs-badge {
    display: inline-block;
    padding: 6px 14px;
    background: var(--color-amber-subtle);
    color: var(--color-amber);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }
  .page-header h1 {
    font-size: var(--text-4xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }
  .page-lead {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 800px;
    margin-bottom: var(--space-8);
  }
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }
  .event-card {
    background: white;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-warm-gray);
    box-shadow: var(--shadow-sm);
  }
  .event-card__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-amber);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .event-card h3 {
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }
  .event-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }
  .event-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }
  .events-invite {
    background: white;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--color-amber);
    box-shadow: var(--shadow-sm);
    max-width: 800px;
  }
  .events-invite h2 {
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }
  .events-invite p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }
</style>
