---
// src/pages/lp-bucomaxilo-ortognatica.astro
// Landing page da campanha 2 de Google Ads (cirurgia ortognática e
// bucomaxilofacial — Juiz de Fora), contraparte da /lp-dtm-bruxismo.
// Estrutura, rastreamento e estilos comuns em LandingLayout / landing.css.
import { Image } from 'astro:assets';
import LandingLayout from '../layouts/LandingLayout.astro';
import Depoimentos from '../components/Depoimentos.astro';
import draVanessaFoto from '../assets/images/dra-vanessa-sobre.jpg';
import { siteConfig } from '../data/site';
import { depoimentos } from '../data/depoimentos';

// Mensagem fixa da campanha, codificada do mesmo jeito que a da LP de DTM —
// não trocar por waLink(), para o lead chegar identificado como do anúncio.
const whatsappHref =
  'https://wa.me/5532998513101?text=Ol%C3%A1%2C%20vi%20o%20an%C3%BAncio%20sobre%20cirurgia%20ortogn%C3%A1tica%2Fbucomaxilofacial%20e%20gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o.';

const local = siteConfig.address;

const { google, doctoralia } = siteConfig.reviews;

const numeros = [
  { valor: siteConfig.stats.years, rotulo: 'anos de experiência' },
  { valor: siteConfig.stats.patients, rotulo: 'pacientes atendidos' },
  { valor: google.rating, rotulo: `no Google · ${google.count} avaliações` },
  { valor: doctoralia.rating, rotulo: `no Doctoralia · ${doctoralia.count} avaliações` },
];

// Só relatos de cirurgia, focados no processo e no cuidado (sem promessa de
// resultado). Enquanto não houver nenhum real e autorizado em depoimentos.ts
// com tema 'cirurgia', a seção não aparece.
const depoimentosLp = depoimentos.filter((d) => d.tema === 'cirurgia' && !d.citaMetodo);

const casos = [
  'Um ortodontista te orientou a fazer cirurgia ortognática para corrigir o encaixe da mordida',
  'Você tem assimetria facial, queixo muito recuado ou projetado, ou dificuldade para mastigar por desalinhamento da mandíbula',
  'Sofreu um trauma no rosto — acidente, queda, impacto esportivo — e precisa de avaliação cirúrgica',
  'Um exame de imagem apontou um cisto ou tumor na região da face ou da mandíbula',
  'Precisa de uma extração cirúrgica mais complexa e quer uma segunda opinião especializada',
  'Está buscando um cirurgião bucomaxilofacial para acompanhar o caso junto com o seu ortodontista',
];

const motivos = [
  'Um problema de encaixe da mordida não tratado pode sobrecarregar a articulação da mandíbula e os dentes ao longo dos anos',
  'Traumas faciais não avaliados a tempo podem cicatrizar de forma inadequada, dificultando a correção depois',
  'Cistos e tumores tendem a crescer se não forem acompanhados, o que pode aumentar a complexidade do tratamento',
  'Quanto antes o planejamento cirúrgico começa — inclusive em conjunto com o ortodontista — mais previsível tende a ser o caminho até a cirurgia',
];

const passos = [
  { titulo: 'Contato', texto: 'você entra em contato pelo WhatsApp e agenda sua avaliação.' },
  {
    titulo: 'Avaliação inicial',
    texto: 'exame clínico e análise dos exames de imagem que você já tiver (ou orientação sobre quais pedir).',
  },
  {
    titulo: 'Diagnóstico e discussão do caso',
    texto: 'explicação clara das opções, incluindo se o caso pede acompanhamento conjunto com seu ortodontista.',
  },
  {
    titulo: 'Planejamento cirúrgico',
    texto: 'definição da conduta, dos exames pré-operatórios e do passo a passo até a cirurgia.',
  },
];

// TODO: revisar com a Dra. Vanessa antes de ligar a campanha — as 4 primeiras
// respostas são rascunhos (o briefing deixou em aberto), escritos no mesmo tom
// da LP de DTM: sem números fechados e sem prometer resultado.
const faq = [
  {
    pergunta: 'A cirurgia ortognática dói muito?',
    resposta:
      'A cirurgia é feita sob anestesia geral, então não há dor durante o procedimento. No pós-operatório é comum haver inchaço e desconforto, que são controlados com medicação e cuidados orientados — tudo é explicado com antecedência na consulta de planejamento.',
  },
  {
    pergunta: 'Quanto tempo leva a recuperação?',
    resposta:
      'Varia de pessoa para pessoa, de acordo com o tipo de cirurgia e a resposta de cada organismo. Os primeiros dias pedem mais repouso e cuidados com a alimentação, e a volta à rotina é gradual. A previsão para o seu caso é explicada com clareza no planejamento cirúrgico.',
  },
  {
    pergunta: 'Preciso estar com o aparelho ortodôntico pronto antes da cirurgia?',
    resposta:
      'Depende do planejamento feito em conjunto com o seu ortodontista. Em geral, o aparelho prepara a arcada antes da cirurgia e segue depois dela para o ajuste final da mordida. Se você ainda não tem ortodontista, isso também é orientado na avaliação.',
  },
  {
    pergunta: 'A cirurgia é feita em hospital?',
    resposta:
      'A cirurgia ortognática e as cirurgias de maior porte são realizadas em ambiente hospitalar. Procedimentos menores, como algumas extrações, podem ser feitos no consultório. O local de cada caso é definido no planejamento.',
  },
  { pergunta: 'O atendimento aceita convênio?', resposta: 'O atendimento é particular.' },
];
---

<LandingLayout
  title="Cirurgia Ortognática e Bucomaxilofacial em Juiz de Fora | Dra. Vanessa Zaidan Silveira"
  description="Precisa de cirurgia ortognática ou avaliação com cirurgiã bucomaxilofacial? Atendimento especializado em ortognática, traumas faciais e cistos em Juiz de Fora. Agende pelo WhatsApp."
  lpName="bucomaxilo-ortognatica"
  whatsappHref={whatsappHref}
  local={local}
>
  <!-- 1. HERO -->
  <section class="lp-hero" aria-labelledby="lp-hero-title">
    <div class="lp-wrap lp-hero__inner">
      <p class="lp-overline">Cirurgia Bucomaxilofacial · Ortognática · Juiz de Fora</p>
      <h1 id="lp-hero-title" class="lp-hero__title">
        Precisa de cirurgia ortognática ou de um <em>cirurgião bucomaxilofacial de confiança?</em>
      </h1>
      <p class="lp-hero__subtitle">
        Avaliação e planejamento cirúrgico especializado com a Dra. Vanessa Zaidan Silveira, cirurgiã e traumatologista
        bucomaxilofacial em Juiz de Fora.
      </p>
      <a href={whatsappHref} target="_blank" rel="noopener" class="vs-btn vs-btn--primary lp-cta" data-lp-cta="hero">
        <svg class="lp-cta__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#icon-whatsapp" /></svg>
        Falar com a Dra. Vanessa no WhatsApp
      </a>
      <p class="vs-cta-note">Atendimento particular</p>
      <ul class="lp-proof" aria-label="Avaliações de pacientes">
        <li>
          <span class="lp-proof__stars" aria-hidden="true">
            {Array.from({ length: 5 }, () => <svg viewBox="0 0 20 20" fill="currentColor"><use href="#icon-star" /></svg>)}
          </span>
          <span><strong>{google.rating}</strong> no Google ({google.count} avaliações)</span>
        </li>
        <li>
          <span><strong>{doctoralia.rating}</strong> no Doctoralia ({doctoralia.count} avaliações)</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 2. CASOS -->
  <section class="lp-block lp-sintomas" aria-labelledby="lp-casos-title">
    <div class="lp-wrap">
      <h2 id="lp-casos-title" class="lp-title vs-reveal">Você se encaixa em algum desses casos?</h2>
      <ul class="lp-checklist">
        {casos.map((item) => (
          <li class="lp-checklist__item vs-reveal">
            <span class="lp-checklist__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="#icon-check" /></svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="lp-support vs-reveal">
        Se você se encaixa em algum desses casos, o primeiro passo é uma avaliação especializada.
      </p>
      <div class="lp-actions vs-reveal">
        <a href={whatsappHref} target="_blank" rel="noopener" class="vs-btn vs-btn--primary lp-cta" data-lp-cta="casos">
          <svg class="lp-cta__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#icon-whatsapp" /></svg>
          Quero agendar minha avaliação
        </a>
      </div>
    </div>
  </section>

  <!-- 3. EDUCAÇÃO -->
  <section class="lp-block lp-educacao" aria-labelledby="lp-educacao-title">
    <div class="lp-wrap lp-wrap--text">
      <h2 id="lp-educacao-title" class="lp-title vs-reveal">O que é cirurgia ortognática e cirurgia bucomaxilofacial, afinal?</h2>
      <div class="lp-prose vs-reveal">
        <p>
          A <strong>cirurgia ortognática</strong> corrige o posicionamento dos ossos da face — maxila e/ou mandíbula —
          quando o desalinhamento vai além do que o aparelho ortodôntico sozinho resolve. Geralmente é feita em conjunto
          com um ortodontista: o aparelho prepara a arcada antes e depois da cirurgia, e a cirurgia corrige o encaixe ósseo.
        </p>
        <p>
          A <strong>cirurgia bucomaxilofacial</strong> é a especialidade odontológica voltada para o diagnóstico e
          tratamento cirúrgico de problemas na face, na mandíbula e nas estruturas ao redor — o que inclui, além da
          ortognática, traumas faciais, cistos e tumores odontogênicos e extrações cirúrgicas complexas.
        </p>
        <p class="lp-prose__highlight">
          Por envolver ossos, nervos e estruturas da face, esse tipo de cirurgia pede planejamento detalhado e uma
          avaliação clínica e por imagem cuidadosa antes de qualquer decisão.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. POR QUE NÃO ADIAR -->
  <section class="lp-block lp-riscos" aria-labelledby="lp-motivos-title">
    <div class="lp-wrap">
      <h2 id="lp-motivos-title" class="lp-title vs-reveal">Por que vale buscar avaliação logo</h2>
      <ul class="lp-riscos__list">
        {motivos.map((item) => (
          <li class="lp-riscos__item vs-reveal">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. AUTORIDADE -->
  <section class="lp-block lp-autoridade" aria-labelledby="lp-autoridade-title">
    <div class="lp-wrap lp-autoridade__inner">
      <div class="lp-autoridade__photo vs-reveal">
        <!-- TODO: foto — usando por enquanto a foto de "Sobre" do banco do site; substituir pela foto profissional escolhida para a campanha -->
        <Image
          src={draVanessaFoto}
          alt="Dra. Vanessa Zaidan Silveira, cirurgiã bucomaxilofacial"
          widths={[360, 560]}
          sizes="(min-width: 768px) 400px, 80vw"
          format="webp"
          quality={70}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="lp-autoridade__content">
        <h2 id="lp-autoridade-title" class="lp-title vs-reveal">Quem vai cuidar do seu caso</h2>
        <p class="lp-autoridade__cro vs-reveal">
          <span>{siteConfig.cro}</span> Cirurgiã e Traumatologista Bucomaxilofacial
        </p>
        <p class="lp-autoridade__bio vs-reveal">
          A Dra. Vanessa Zaidan Silveira é Cirurgiã e Traumatologista Bucomaxilofacial ({siteConfig.cro}), com atuação em
          cirurgia ortognática, traumas faciais, cistos e tumores da face e cirurgias orais complexas. Sua formação permite
          um planejamento cirúrgico que leva em conta a anatomia da face, da articulação e dos nervos envolvidos em cada
          caso.
        </p>
        <p class="lp-autoridade__bio vs-reveal">
          Também é mestranda em Inovação e Tecnologia em Saúde pela UFJF, com pesquisa voltada a tecnologias de mapeamento
          de nervos periféricos — um tema diretamente ligado à segurança em cirurgias na região da face.
        </p>
        <ul class="lp-stats vs-reveal" aria-label="Experiência e avaliações">
          {numeros.map((n) => (
            <li>
              <strong>{n.valor}</strong>
              <span>{n.rotulo}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. DEPOIMENTOS — só relatos reais de cirurgia (tema 'cirurgia' em depoimentos.ts) -->
  <!-- TODO: depoimentos — cadastrar relatos reais e autorizados, sobre o processo e o cuidado, sem promessa de resultado -->
  {depoimentosLp.length > 0 && (
    <Depoimentos
      items={depoimentosLp}
      showBadges={false}
      overline="Relatos de pacientes"
      title="Como foi a experiência de quem passou pela avaliação"
    />
  )}

  <!-- 7. COMO FUNCIONA -->
  <section class="lp-block lp-passos" aria-labelledby="lp-passos-title">
    <div class="lp-wrap">
      <h2 id="lp-passos-title" class="lp-title vs-reveal">Como funciona a avaliação</h2>
      <ol class="lp-passos__list">
        {passos.map((passo, i) => (
          <li class="lp-passos__item vs-reveal" data-delay={String(i + 1)}>
            <span class="lp-passos__num" aria-hidden="true">{i + 1}</span>
            <p><strong>{passo.titulo}:</strong> {passo.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="lp-block lp-faq" aria-labelledby="lp-faq-title">
    <div class="lp-wrap lp-wrap--text">
      <h2 id="lp-faq-title" class="lp-title vs-reveal">Perguntas frequentes</h2>
      <div class="lp-faq__list">
        {faq.map((item) => (
          <details class="lp-faq__item">
            <summary>{item.pergunta}</summary>
            <p>{item.resposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. CTA FINAL + LOCALIZAÇÃO (mesmo bloco da LP de DTM) -->
  <section class="lp-block lp-final" aria-labelledby="lp-final-title">
    <div class="lp-wrap lp-wrap--text lp-final__inner">
      <h2 id="lp-final-title" class="lp-title vs-reveal">Agende sua avaliação</h2>
      <p class="lp-final__address vs-reveal">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
        <span>
          Atendimento em Juiz de Fora (MG), na {local.clinic} — {local.street}, {local.cityLine}.
        </span>
      </p>
      <div class="lp-actions vs-reveal">
        <a href={whatsappHref} target="_blank" rel="noopener" class="vs-btn vs-btn--primary lp-cta" data-lp-cta="cta-final">
          <svg class="lp-cta__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#icon-whatsapp" /></svg>
          Agendar avaliação pelo WhatsApp
        </a>
        <p class="vs-cta-note">Atendimento particular</p>
      </div>
    </div>
  </section>
</LandingLayout>
