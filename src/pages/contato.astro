---
// src/pages/contato.astro
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ContatoSection from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contato e Agendamentos | Dra. Vanessa Silveira"
  description="Agende sua avaliação com a Dra. Vanessa Silveira em Juiz de Fora. Fale por WhatsApp, telefone ou e-mail e veja o endereço da clínica."
>
  <Nav />
  <main class="page-container">
    <h1 class="sr-only">Contato e Agendamentos — Dra. Vanessa Silveira</h1>
    <ContatoSection />
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding-top: var(--space-12);
    background: var(--color-cream);
    min-height: 80vh;
  }
</style>
