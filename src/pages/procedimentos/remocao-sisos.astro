---
// src/pages/procedimentos/remocao-sisos.astro
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Remoção de Sisos | Dra. Vanessa Silveira">
  <Nav />
  <main class="vs-section page-container">
    <div class="vs-container">
      <div class="page-header vs-reveal">
        <p class="vs-overline">Procedimento</p>
        <h1 class="vs-font-display">Remoção de Sisos</h1>
        <p class="page-desc">
          Extrações de dentes do siso com técnica minimamente invasiva, focando em segurança e pós-operatório rápido.
        </p>
      </div>
      
      <div class="page-content vs-reveal" data-delay="1">
        <p>Esta página conterá orientações pré e pós-operatórias detalhadas para a extração dos terceiros molares.</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding: var(--space-20) 0 var(--space-16);
    background: var(--color-cream);
    min-height: 80vh;
  }
  .page-header {
    margin-bottom: var(--space-8);
    max-width: var(--max-width-text);
  }
  .page-header h1 {
    font-size: var(--text-4xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }
  .page-desc {
    font-family: var(--font-accent);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-text-secondary);
  }
  .page-content {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: var(--max-width-text);
    line-height: var(--leading-normal);
  }
</style>
