---
// src/pages/procedimentos/index.astro
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Tratamentos from '../../components/Tratamentos.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Procedimentos e Tratamentos | Dra. Vanessa Silveira"
  description="Conheça os procedimentos de Cirurgia Bucomaxilofacial da Dra. Vanessa Silveira: artrocentese, viscossuplementação, cirurgia ortognática e mais."
>
  <Nav />
  <main class="page-container">
    <h1 class="sr-only">Procedimentos e Tratamentos — Dra. Vanessa Silveira</h1>
    <Tratamentos />
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding-top: var(--space-12);
    background: var(--color-cream);
    min-height: 80vh;
  }
</style>
