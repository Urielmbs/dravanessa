---
// src/pages/dra-vanessa.astro
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Sobre from '../components/Sobre.astro';
import Credenciais from '../components/Credenciais.astro';
import Experiencias from '../components/Experiencias.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Sobre a Dra. Vanessa Silveira | Cirurgiã Bucomaxilofacial">
  <Nav />
  <main class="page-container">
    <Sobre />
    <Credenciais />
    <Experiencias />
    <Depoimentos />
    <Contato />
  </main>
  <Footer />
</Layout>

<style>
  .page-container {
    padding-top: var(--space-12);
    background: var(--color-cream);
    min-height: 80vh;
  }
</style>
