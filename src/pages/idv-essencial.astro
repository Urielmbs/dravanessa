---
// src/pages/idv-essencial.astro
// POC de identidade — proposta ESSENCIAL, versão 2.
// A venda acontece por reconhecimento e por competência demonstrada.
// Nenhum gatilho de escassez, urgência fabricada ou apelo emocional forçado:
// a página descortina o mecanismo da dor e informa que existe consulta.
import Layout from '../layouts/Layout.astro';
import '../styles/idv-essencial.css';

const whatsapp = 'https://wa.me/5532998513101';

// Cada sintoma vem com o seu mecanismo. É o par sintoma + explicação que
// produz o reconhecimento: ela já sentiu, mas nunca ouviu o porquê.
const sinais = [
  { sinal: 'Você acorda com a cabeça pesada e a mandíbula cansada.',
    causa: 'Não é sono ruim. É musculatura que trabalhou a noite inteira sem você saber.' },
  { sinal: 'A boca estala, range ou desliza para um lado quando abre.',
    causa: 'O disco da articulação está saindo de posição e voltando a cada movimento.' },
  { sinal: 'Dor no ouvido, zumbido ou sensação de ouvido tampado — e o otorrino não achou nada.',
    causa: 'A articulação fica a milímetros do canal auditivo. A dor é referida, não é do ouvido.' },
  { sinal: 'Dor de cabeça na têmpora, quase sempre do mesmo lado.',
    causa: 'É o músculo temporal em contração contínua. Costuma ser tratado como enxaqueca por anos.' },
  { sinal: 'Cansaço ao mastigar carne, pão, chiclete — e você já evita certos alimentos.',
    causa: 'A musculatura perde resistência antes de terminar a refeição.' },
  { sinal: 'A sensação de que os dentes não encaixam mais como antes.',
    causa: 'A posição do côndilo mudou. Os dentes são o sintoma, não a origem.' },
  { sinal: 'Você já usou placa e não resolveu — ou piorou.',
    causa: 'Placa é instrumento, não tratamento. Existe mais de um tipo, para mais de um problema.' },
  { sinal: 'Alguém já disse que era do estresse e mandou você relaxar.',
    causa: 'Estresse é um fator. Nunca é o diagnóstico.' },
];

const tipos = [
  { n: '01', nome: 'Muscular',
    texto: 'A dor nasce nos músculos da mastigação. Dói ao toque, piora ao longo do dia e se espalha para têmpora e pescoço. É o tipo mais comum e o que mais responde a tratamento conservador.' },
  { n: '02', nome: 'Articular',
    texto: 'O problema está no disco e na articulação. Estalos, travamentos, limitação de abertura. Aqui a placa estabilizadora sozinha raramente resolve.' },
  { n: '03', nome: 'Mista',
    texto: 'As duas coisas ao mesmo tempo — que é o cenário mais frequente em quem já convive com dor há anos. Exige tratar na ordem certa, não tudo de uma vez.' },
];

const consulta = [
  { rotulo: 'Duração', valor: 'Cerca de uma hora' },
  { rotulo: 'Começa por', valor: 'A sua história inteira, antes de qualquer exame' },
  { rotulo: 'Exame clínico', valor: 'Palpação dos músculos da mastigação e do pescoço, medida da abertura de boca em milímetros, ausculta da articulação e avaliação dos movimentos' },
  { rotulo: 'Imagem', valor: 'Solicitada depois, quando muda a conduta — não para descobrir o diagnóstico' },
  { rotulo: 'Você sai com', valor: 'O nome do que você tem e o plano escrito, do menos invasivo para o mais' },
];

const naoE = [
  'Não é harmonização facial nem procedimento estético.',
  'Não é promessa de cura numa sessão.',
  'Não começa por cirurgia — a maioria dos casos nunca chega lá.',
  'Não substitui o seu dentista: trabalha junto com ele.',
];
---

<Layout
  title="Dra. Vanessa Silveira | DTM e dor orofacial em Juiz de Fora e na Barra da Tijuca"
  description="Cirurgia bucomaxilofacial com foco em DTM e dor orofacial crônica. Diagnóstico clínico, tratamento na ordem certa. Juiz de Fora (MG) e Barra da Tijuca (RJ)."
>
  <div class="ess">

    <header class="ess-top">
      <div class="ess-wrap ess-top-inner">
        <a href="/idv-essencial" class="ess-mark">Dra. Vanessa Silveira</a>
        <span class="ess-top-meta">Cirurgia Bucomaxilofacial <span aria-hidden="true">·</span> DTM e Dor Orofacial</span>
        <a href={whatsapp} target="_blank" rel="noopener" class="ess-top-link">Agendar consulta</a>
      </div>
    </header>

    <main>

      <!-- ABERTURA -->
      <section class="ess-open">
        <div class="ess-wrap ess-open-grid">
          <div class="ess-open-col">
            <div class="ess-open-head">
              <h1 class="ess-display">Você não está<br />inventando a sua dor.</h1>
            </div>

            <div class="ess-open-body">
            <p class="ess-lede-text">
              Dor de cabeça quase todo dia. Estalo ao abrir a boca. O maxilar que cansa antes
              do fim da refeição. E exames que voltam normais.
            </p>
            <p class="ess-lede-text ess-lede-text--strong">
              Isso tem nome, tem causa anatômica e tem tratamento. O motivo de ninguém ter
                encontrado até agora costuma ser sempre o mesmo — e está explicado abaixo.
              </p>
            </div>
          </div>

          <figure class="ess-portrait ess-portrait--lead">
            <img
              src="/images/vanessa-rio/vanessa-chao-cadeira.jpg"
              alt="Dra. Vanessa Silveira sentada, em postura tranquila e acolhedora"
              width="691" height="1024" loading="eager" fetchpriority="high"
            />
            <figcaption>Dra. Vanessa Silveira <span aria-hidden="true">·</span> CRO/MG</figcaption>
          </figure>
        </div>
      </section>

      <!-- RECONHECIMENTO: sintoma + mecanismo, em duas colunas -->
      <section class="ess-signs">
        <div class="ess-wrap">
          <div class="ess-signs-head">
            <p class="ess-label">Comece por aqui</p>
            <h2 class="ess-headline">Quantas destas são suas?</h2>
            <p class="ess-note-text">
              Cada uma delas tem uma explicação anatômica. Nenhuma é exagero seu.
            </p>
          </div>

          <ul class="ess-signs-grid">
            {sinais.map((item) => (
              <li class="ess-sign">
                <p class="ess-sign-line">{item.sinal}</p>
                <p class="ess-sign-cause">{item.causa}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- A INVERSÃO: a revelação clínica, a única seção em fundo escuro -->
      <section class="ess-reveal">
        <div class="ess-wrap ess-reveal-grid">
          <div class="ess-reveal-head">
            <p class="ess-label ess-label--light">A parte que não te explicaram</p>
            <h2 class="ess-headline ess-headline--light">
              Por que os seus exames vieram normais
            </h2>
          </div>

          <div class="ess-reveal-body">
            <p>
              A radiografia panorâmica que você fez mostra dentes e osso. Ela não mostra o disco
              articular, que é de cartilagem, nem os músculos da mastigação — que é exatamente
              onde a maior parte da dor de DTM nasce.
            </p>
            <p class="ess-reveal-emphasis">
              Um exame normal não significa que não há nada. Significa que aquele exame não
              olha para onde dói.
            </p>
            <p>
              O diagnóstico de DTM é clínico. Se faz com tempo, com as mãos e com medida.
              A imagem entra depois, para confirmar ou para planejar — nunca para descobrir.
              É por isso que tantas pessoas passam anos com exames impecáveis e dor real.
            </p>
          </div>
        </div>
      </section>

      <!-- POR QUE A PLACA NÃO RESOLVEU -->
      <section class="ess-types">
        <div class="ess-wrap">
          <div class="ess-types-head">
            <p class="ess-label">Por que a placa não resolveu</p>
            <h2 class="ess-headline">Existem três quadros diferentes.</h2>
            <p class="ess-note-text">E o tratamento de um não serve para o outro.</p>
          </div>

          <div class="ess-types-grid">
            {tipos.map((t) => (
              <article class="ess-type">
                <p class="ess-type-n">{t.n}</p>
                <h3 class="ess-title">{t.nome}</h3>
                <p class="ess-body-text">{t.texto}</p>
              </article>
            ))}
          </div>

          <p class="ess-types-close">
            Uma placa feita sem definir qual dos três é o seu caso só acerta por sorte.
            É a razão mais comum de um tratamento de DTM não funcionar.
          </p>
        </div>
      </section>

      <!-- QUEM ATENDE -->
      <section class="ess-about">
        <div class="ess-wrap ess-about-grid">
          <figure class="ess-portrait ess-portrait--about">
            <img
              src="/images/vanessa-rio/vanessa-planta-sorriso.jpg"
              alt="Retrato da Dra. Vanessa Silveira"
              width="632" height="1024" loading="lazy"
            />
          </figure>

          <div class="ess-about-text">
            <p class="ess-label">Quem atende</p>
            <h2 class="ess-headline">
              Sou a Dra. Vanessa Silveira,<br />cirurgiã bucomaxilofacial.
            </h2>
            <p class="ess-body-text">
              Em quase uma década dedicada a dor orofacial, atendi mais de duas mil pessoas.
              A maioria chegou depois de anos ouvindo que não era nada — e trazendo uma pasta
              de exames normais.
            </p>
            <p class="ess-body-text">
              O que mudou o resultado dessas pessoas não foi uma técnica nova. Foi a primeira
              consulta ter tempo para a história inteira antes de olhar qualquer imagem.
              Sem isso, o tratamento acerta o sintoma e erra a causa — e a dor volta.
            </p>

            <dl class="ess-creds">
              <div><dt>Formação</dt><dd>Especialista em Cirurgia e Traumatologia Bucomaxilofacial</dd></div>
              <div><dt>Atuação</dt><dd>DTM, dor orofacial crônica e cirurgia ortognática</dd></div>
              <div><dt>Registro</dt><dd>CRO/MG</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- A PRIMEIRA CONSULTA: dados, não promessas -->
      <section class="ess-visit">
        <div class="ess-wrap ess-visit-grid">
          <div class="ess-visit-head">
            <p class="ess-label">A primeira consulta</p>
            <h2 class="ess-headline">O que acontece,<br />exatamente.</h2>
          </div>

          <dl class="ess-visit-list">
            {consulta.map((linha) => (
              <div class="ess-visit-row">
                <dt>{linha.rotulo}</dt>
                <dd>{linha.valor}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- LIMITES HONESTOS -->
      <section class="ess-limits">
        <div class="ess-wrap ess-limits-grid">
          <p class="ess-label">Para ser claro</p>
          <ul class="ess-limits-list">
            {naoE.map((linha) => <li>{linha}</li>)}
          </ul>
        </div>
      </section>

      <!-- DISPONIBILIDADE — não é pedido, é informação -->
      <section class="ess-close">
        <div class="ess-wrap ess-close-grid">
          <div class="ess-close-text">
            <h2 class="ess-close-line">
              A consulta existe e a agenda está aberta.
              O próximo passo é seu.
            </h2>

            <div class="ess-where">
              <div class="ess-where-item">
                <p class="ess-label">Juiz de Fora <span aria-hidden="true">·</span> MG</p>
                <p class="ess-address">Av. Barão do Rio Branco, 2872 — Centro</p>
                <p class="ess-where-status">Agenda aberta</p>
              </div>
              <div class="ess-where-item">
                <p class="ess-label">Barra da Tijuca <span aria-hidden="true">·</span> RJ</p>
                <p class="ess-address">Nova unidade</p>
                <p class="ess-where-status">Agenda em formação</p>
              </div>
            </div>

            <a href={whatsapp} target="_blank" rel="noopener" class="ess-button">Agendar consulta</a>
            <p class="ess-note">WhatsApp <span aria-hidden="true">·</span> resposta no mesmo dia</p>
          </div>

          <figure class="ess-portrait ess-portrait--close">
            <img
              src="/images/vanessa-rio/vanessa-sofa-folhagem.jpg"
              alt="Dra. Vanessa Silveira em ambiente de atendimento"
              width="708" height="1024" loading="lazy"
            />
          </figure>
        </div>
      </section>

    </main>

    <footer class="ess-foot">
      <div class="ess-wrap ess-foot-inner">
        <p>Dra. Vanessa Silveira <span aria-hidden="true">·</span> Cirurgia Bucomaxilofacial <span aria-hidden="true">·</span> CRO/MG</p>
        <nav class="ess-foot-nav">
          <a href="/home-rio">Proposta anterior</a>
          <a href="/idv-brasileira">Canvas da IDV</a>
          <a href="/politica-de-privacidade">Privacidade</a>
        </nav>
      </div>
    </footer>

  </div>
</Layout>

<style>
  /* ==========================================================================
     Três fontes de vida, nenhuma delas ornamental:
     1. escala de PESOS (300–700) e o eixo de largura da Archivo
     2. composição assimétrica sobre grid de 12 colunas
     3. uma única inversão de fundo, na seção que carrega a revelação
     ========================================================================== */

  .ess {
    background: var(--ess-linen);
    color: var(--ess-ink);
    font-family: var(--ess-font);
    font-size: var(--ess-body);
    line-height: 1.68;
    -webkit-font-smoothing: antialiased;
  }

  .ess-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: var(--ess-gutter);
  }

  /* --- TOPO --- */
  .ess-top {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--ess-rule-soft);
  }

  .ess-top-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .ess-mark {
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 96%;
    letter-spacing: -0.005em;
    color: var(--ess-ink);
    text-decoration: none;
  }

  .ess-top-meta {
    font-size: var(--ess-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ess-muted);
  }

  .ess-top-link,
  .ess-link {
    font-size: var(--ess-small);
    font-weight: 500;
    color: var(--ess-ink);
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--ess-rule);
    transition: text-decoration-color 200ms var(--ess-ease);
  }

  .ess-top-link:hover,
  .ess-link:hover { text-decoration-color: var(--ess-ink); }

  /* --- TIPOS DE BASE --- */
  .ess-display {
    font-size: var(--ess-display);
    font-weight: 600;
    font-stretch: 92%;
    line-height: 1.02;
    letter-spacing: -0.032em;
    margin: 0;
  }

  .ess-headline {
    font-size: var(--ess-headline);
    font-weight: 500;
    font-stretch: 96%;
    line-height: 1.16;
    letter-spacing: -0.024em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }

  .ess-title {
    font-size: var(--ess-title);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.014em;
    margin: 0 0 0.75rem;
  }

  .ess-label {
    font-size: var(--ess-label);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ess-muted);
    margin: 0 0 1.25rem;
  }

  .ess-label--light { color: var(--ess-deep-tint); }

  .ess-body-text {
    font-size: var(--ess-body);
    font-weight: 400;
    line-height: 1.72;
    color: var(--ess-muted);
    margin: 0 0 1.15rem;
    max-width: 54ch;
  }

  .ess-note-text {
    font-size: var(--ess-small);
    color: var(--ess-muted);
    margin: 0;
    max-width: 44ch;
  }

  /* --- ABERTURA: grid de 12, com o texto entrando na coluna 2 --- */
  .ess-open {
    padding-block: clamp(3.5rem, 7vw, 6rem) var(--ess-section);
  }

  .ess-open-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    row-gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  /* O texto ocupa as colunas 1–7 e o retrato as 8–12: sem sobreposição, o
     que evita que o auto-placement empurre o texto para depois da imagem. */
  .ess-open-col {
    grid-column: 1 / 8;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    row-gap: clamp(2rem, 4vw, 3.25rem);
  }

  .ess-open-head { grid-column: 1 / 8; }

  /* O corpo não começa na margem: entra uma coluna. É o degrau que a
     composição repete depois nas outras seções. */
  .ess-open-body {
    grid-column: 2 / 8;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .ess-lede-text {
    font-size: var(--ess-lede);
    font-weight: 400;
    line-height: 1.55;
    color: var(--ess-muted);
    margin: 0;
  }

  .ess-lede-text--strong {
    color: var(--ess-ink);
    font-weight: 500;
  }

  .ess-portrait { margin: 0; }

  .ess-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: var(--ess-linen-deep);
  }

  .ess-portrait figcaption {
    font-size: var(--ess-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ess-muted);
    margin-top: 0.85rem;
  }

  .ess-portrait--lead {
    grid-column: 8 / 13;
  }

  /* --- SINAIS: duas colunas, peso separando sintoma de mecanismo --- */
  .ess-signs {
    padding-block: 0 var(--ess-section);
  }

  .ess-signs-head {
    max-width: 46ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .ess-signs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid var(--ess-ink);
  }

  .ess-sign {
    padding-block: clamp(1.4rem, 2.5vw, 1.9rem);
    border-bottom: 1px solid var(--ess-rule-soft);
  }

  .ess-sign-line {
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.014em;
    color: var(--ess-ink);
    margin: 0 0 0.45rem;
  }

  .ess-sign-cause {
    font-size: var(--ess-small);
    font-weight: 400;
    line-height: 1.6;
    color: var(--ess-muted);
    margin: 0;
  }

  /* --- A INVERSÃO --- */
  .ess-reveal {
    background: var(--ess-deep);
    color: var(--ess-linen);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    margin-bottom: var(--ess-section);
  }

  .ess-reveal-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    row-gap: 2.5rem;
  }

  .ess-reveal-head { grid-column: 1 / 6; }
  .ess-reveal-body { grid-column: 7 / 13; }

  .ess-headline--light { color: var(--ess-linen); }

  .ess-reveal-body p {
    font-size: var(--ess-lede);
    font-weight: 300;
    line-height: 1.66;
    color: var(--ess-deep-tint);
    margin: 0 0 1.5rem;
  }

  .ess-reveal-body p:last-child { margin-bottom: 0; }

  .ess-reveal-emphasis {
    color: var(--ess-linen) !important;
    font-weight: 500 !important;
    padding-block: 1.5rem;
    border-block: 1px solid var(--ess-deep-rule);
  }

  /* --- TRÊS QUADROS --- */
  .ess-types { padding-block: 0 var(--ess-section); }

  .ess-types-head {
    max-width: 34ch;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .ess-types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .ess-type {
    border-top: 2px solid var(--ess-ink);
    padding-top: 1.25rem;
  }

  .ess-type-n {
    font-size: var(--ess-label);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.14em;
    color: var(--ess-muted);
    margin: 0 0 1.5rem;
  }

  .ess-type .ess-body-text { margin: 0; }

  .ess-types-close {
    font-size: var(--ess-lede);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.014em;
    max-width: 40ch;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0 auto;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ess-rule);
  }

  /* --- QUEM ATENDE --- */
  .ess-about { padding-block: 0 var(--ess-section); }

  .ess-about-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    row-gap: 2.5rem;
    align-items: start;
  }

  .ess-portrait--about { grid-column: 1 / 5; }
  .ess-about-text { grid-column: 6 / 12; }

  .ess-creds {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ess-rule);
    display: grid;
    gap: 0.85rem;
  }

  .ess-creds > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .ess-creds dt {
    font-size: var(--ess-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ess-muted);
  }

  .ess-creds dd {
    margin: 0;
    font-size: var(--ess-small);
    font-weight: 400;
    line-height: 1.5;
  }

  /* --- A CONSULTA: tabela de dados, porque dado é o que prova competência --- */
  .ess-visit { padding-block: 0 var(--ess-section); }

  .ess-visit-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    row-gap: 2.5rem;
    align-items: start;
  }

  .ess-visit-head { grid-column: 1 / 5; }
  .ess-visit-list { grid-column: 6 / 13; margin: 0; }

