---
// src/pages/idv-essencial.astro — POC de identidade, proposta ESSENCIAL v3.
//
// A espinha da página são as frases grandes. Lidas sozinhas, na ordem, elas
// contam a história inteira — é o que segura quem escaneia. A prosa embaixo
// existe para quem decidiu ler, e nunca para carregar o argumento.
import Layout from '../layouts/Layout.astro';
import '../styles/idv-essencial.css';

const whatsapp = 'https://wa.me/5532998513101';

const sinais = [
  { sinal: 'Você acorda com a cabeça pesada e a mandíbula cansada.',
    causa: 'Musculatura que trabalhou a noite inteira. Não é sono ruim.' },
  { sinal: 'A boca estala, range ou desliza para um lado quando abre.',
    causa: 'O disco da articulação sai de posição e volta a cada movimento.' },
  { sinal: 'Dor no ouvido ou zumbido — e o otorrino não achou nada.',
    causa: 'A articulação fica a milímetros do canal auditivo. A dor é referida.' },
  { sinal: 'Dor de cabeça na têmpora, quase sempre do mesmo lado.',
    causa: 'Músculo temporal em contração contínua. Tratado como enxaqueca por anos.' },
  { sinal: 'Cansaço ao mastigar, e você já evita certos alimentos.',
    causa: 'A musculatura perde resistência antes do fim da refeição.' },
  { sinal: 'A sensação de que os dentes não encaixam mais como antes.',
    causa: 'A posição do côndilo mudou. Os dentes são o sintoma, não a origem.' },
  { sinal: 'Você já usou placa e não resolveu — ou piorou.',
    causa: 'Placa é instrumento, não tratamento. Existe mais de um tipo.' },
  { sinal: 'Alguém já disse que era do estresse e mandou você relaxar.',
    causa: 'Estresse é um fator. Nunca é o diagnóstico.' },
];

const tipos = [
  { n: '01', nome: 'Muscular', resumo: 'A dor nasce no músculo.',
    texto: 'Dói ao toque, piora ao longo do dia e se espalha para têmpora e pescoço. É o tipo mais comum e o que melhor responde a tratamento conservador.' },
  { n: '02', nome: 'Articular', resumo: 'A dor nasce na articulação.',
    texto: 'Estalos, travamentos, limitação de abertura. O disco perdeu a posição. Aqui a placa estabilizadora sozinha raramente resolve.' },
  { n: '03', nome: 'Mista', resumo: 'As duas ao mesmo tempo.',
    texto: 'O cenário mais frequente em quem convive com dor há anos. Exige tratar na ordem certa — músculo antes de articulação — e não tudo de uma vez.' },
];

const consulta = [
  { rotulo: 'Duração', valor: 'Cerca de uma hora.' },
  { rotulo: 'Começa por', valor: 'A sua história inteira, antes de qualquer exame.' },
  { rotulo: 'Exame', valor: 'Palpação dos músculos da mastigação e do pescoço, medida da abertura de boca em milímetros, ausculta da articulação e avaliação dos movimentos.' },
  { rotulo: 'Imagem', valor: 'Solicitada depois, quando muda a conduta. Nunca para descobrir o diagnóstico.' },
  { rotulo: 'Você sai com', valor: 'O nome do que você tem e o plano escrito, do menos invasivo para o mais.' },
];

const naoE = [
  'Não é harmonização facial nem procedimento estético.',
  'Não é promessa de cura numa sessão.',
  'Não começa por cirurgia — a maioria dos casos nunca chega lá.',
  'Não substitui o seu dentista: trabalha junto com ele.',
];
---

<Layout
  title="Dra. Vanessa Silveira | DTM e dor orofacial em Juiz de Fora e na Barra da Tijuca"
  description="Cirurgia bucomaxilofacial com foco em DTM e dor orofacial crônica. Diagnóstico clínico, tratamento na ordem certa. Juiz de Fora (MG) e Barra da Tijuca (RJ)."
>
  <div class="ess">

    <header class="ess-top">
      <div class="ess-wrap ess-top-inner">
        <a href="/idv-essencial" class="ess-mark">Dra. Vanessa Silveira</a>
        <span class="ess-top-meta">Cirurgia Bucomaxilofacial <span aria-hidden="true">·</span> DTM e Dor Orofacial</span>
        <a href={whatsapp} target="_blank" rel="noopener" class="ess-top-link">Agendar consulta</a>
      </div>
    </header>

    <main>

      <!-- ═══ 01 ═══ -->
      <section class="ess-open">
        <div class="ess-wrap ess-open-grid">
          <div class="ess-open-col">
            <h1 class="ess-display">Você não está<br />inventando a sua dor.</h1>
            <p class="ess-read-text ess-read-text--lead">
              <strong>Dor de cabeça quase todo dia.</strong> Estalo ao abrir a boca. O maxilar
              que cansa antes do fim da refeição. E exames que voltam normais.
            </p>
            <p class="ess-read-text">
              Isso tem nome, tem causa anatômica e tem tratamento. O motivo de ninguém ter
              encontrado até agora costuma ser sempre o mesmo.
            </p>
          </div>

          <figure class="ess-portrait ess-portrait--lead">
            <img
              src="/images/vanessa-rio/vanessa-chao-cadeira.jpg"
              alt="Dra. Vanessa Silveira sentada, em postura tranquila e acolhedora"
              width="691" height="1024" loading="eager" fetchpriority="high"
            />
            <figcaption>Dra. Vanessa Silveira <span aria-hidden="true">·</span> CRO/MG</figcaption>
          </figure>
        </div>
      </section>

      <!-- ═══ 02 · SINAIS ═══ -->
      <section class="ess-signs">
        <div class="ess-wrap">
          <p class="ess-label">01 <span aria-hidden="true">—</span> Comece por aqui</p>
          <h2 class="ess-statement">Quantas destas são suas?</h2>

          <ul class="ess-signs-grid">
            {sinais.map((item) => (
              <li class="ess-sign">
                <p class="ess-sign-line">{item.sinal}</p>
                <p class="ess-sign-cause">{item.causa}</p>
              </li>
            ))}
          </ul>

          <p class="ess-read-text ess-read-text--after">
            Cada uma delas tem explicação anatômica. <strong>Nenhuma é exagero seu</strong> —
            e é justamente por serem sintomas espalhados pelo corpo que a DTM passa tantos
            anos sem ser identificada.
          </p>
        </div>
      </section>

      <!-- ═══ 03 · A INVERSÃO ═══ -->
      <section class="ess-reveal">
        <div class="ess-wrap">
          <p class="ess-label ess-label--light">02 <span aria-hidden="true">—</span> A parte que não te explicaram</p>

          <h2 class="ess-statement ess-statement--light">
            Os seus exames vieram normais porque não olharam para onde dói.
          </h2>

          <div class="ess-reveal-cols">
            <p class="ess-read-text ess-read-text--light">
              <strong>A radiografia panorâmica mostra dentes e osso.</strong> Ela não mostra o
              disco articular, que é de cartilagem, nem os músculos da mastigação — que é
              exatamente onde a maior parte da dor de DTM nasce.
            </p>
            <p class="ess-read-text ess-read-text--light">
              <strong>O diagnóstico de DTM é clínico.</strong> Se faz com tempo, com as mãos e
              com medida. A imagem entra depois, para confirmar ou para planejar. É por isso
              que tanta gente passa anos com exames impecáveis e dor real.
            </p>
          </div>
        </div>
      </section>

      <!-- ═══ 04 · TRÊS QUADROS ═══ -->
      <section class="ess-types">
        <div class="ess-wrap">
          <p class="ess-label">03 <span aria-hidden="true">—</span> Por que a placa não resolveu</p>
          <h2 class="ess-statement">Existem três quadros diferentes.<br />A sua placa foi feita para um deles.</h2>

          <div class="ess-types-grid">
            {tipos.map((t) => (
              <article class="ess-type">
                <p class="ess-type-n">{t.n}</p>
                <h3 class="ess-type-name">{t.nome}</h3>
                <p class="ess-type-sum">{t.resumo}</p>
                <p class="ess-read-text ess-read-text--sm">{t.texto}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ═══ 05 · QUEM ATENDE ═══ -->
      <section class="ess-about">
        <div class="ess-wrap ess-about-grid">
          <figure class="ess-portrait ess-portrait--about">
            <img
              src="/images/vanessa-rio/vanessa-planta-sorriso.jpg"
              alt="Retrato da Dra. Vanessa Silveira"
              width="632" height="1024" loading="lazy"
            />
          </figure>

          <div class="ess-about-text">
            <p class="ess-label">04 <span aria-hidden="true">—</span> Quem atende</p>
            <h2 class="ess-statement">Sou a Dra. Vanessa Silveira, cirurgiã bucomaxilofacial.</h2>

            <p class="ess-read-text">
              <strong>Em quase uma década dedicada a dor orofacial</strong>, atendi mais de duas
              mil pessoas. A maioria chegou depois de anos ouvindo que não era nada, trazendo
              uma pasta de exames normais.
            </p>
            <p class="ess-read-text">
              O que mudou o resultado delas não foi técnica nova. Foi a primeira consulta ter
              tempo para a história inteira antes de olhar qualquer imagem. <em>Sem isso, o
              tratamento acerta o sintoma e erra a causa</em> — e a dor volta.
            </p>

            <dl class="ess-creds">
              <div><dt>Formação</dt><dd>Especialista em Cirurgia e Traumatologia Bucomaxilofacial</dd></div>
              <div><dt>Atuação</dt><dd>DTM, dor orofacial crônica e cirurgia ortognática</dd></div>
              <div><dt>Registro</dt><dd>CRO/MG</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- ═══ 06 · A CONSULTA ═══ -->
      <section class="ess-visit">
        <div class="ess-wrap">
          <p class="ess-label">05 <span aria-hidden="true">—</span> A primeira consulta</p>
          <h2 class="ess-statement">Você sai com o nome do que tem.</h2>

          <dl class="ess-visit-list">
            {consulta.map((linha) => (
              <div class="ess-visit-row">
                <dt>{linha.rotulo}</dt>
                <dd>{linha.valor}</dd>
              </div>
            ))}
          </dl>

          <div class="ess-limits">
            <p class="ess-label">Para ser claro</p>
            <ul class="ess-limits-list">
              {naoE.map((linha) => <li>{linha}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- ═══ 07 · DISPONIBILIDADE ═══ -->
      <section class="ess-close">
        <div class="ess-wrap ess-close-grid">
          <div class="ess-close-text">
            <h2 class="ess-statement ess-statement--close">
              A consulta existe e a agenda está aberta. O próximo passo é seu.
            </h2>

            <div class="ess-where">
              <div class="ess-where-item">
                <p class="ess-label">Juiz de Fora <span aria-hidden="true">·</span> MG</p>
                <p class="ess-address">Av. Barão do Rio Branco, 2872 — Centro</p>
                <p class="ess-where-status">Agenda aberta</p>
              </div>
              <div class="ess-where-item">
                <p class="ess-label">Barra da Tijuca <span aria-hidden="true">·</span> RJ</p>
                <p class="ess-address">Nova unidade</p>
                <p class="ess-where-status">Agenda em formação</p>
              </div>
            </div>

            <a href={whatsapp} target="_blank" rel="noopener" class="ess-button">Agendar consulta</a>
            <p class="ess-note">WhatsApp <span aria-hidden="true">·</span> resposta no mesmo dia</p>
          </div>

          <figure class="ess-portrait ess-portrait--close">
            <img
              src="/images/vanessa-rio/vanessa-sofa-folhagem.jpg"
              alt="Dra. Vanessa Silveira em ambiente de atendimento"
              width="708" height="1024" loading="lazy"
            />
          </figure>
        </div>
      </section>

    </main>

    <footer class="ess-foot">
      <div class="ess-wrap ess-foot-inner">
        <p>Dra. Vanessa Silveira <span aria-hidden="true">·</span> Cirurgia Bucomaxilofacial <span aria-hidden="true">·</span> CRO/MG</p>
        <nav class="ess-foot-nav">
          <a href="/home-rio">Proposta anterior</a>
          <a href="/idv-brasileira">Canvas da IDV</a>
          <a href="/politica-de-privacidade">Privacidade</a>
        </nav>
      </div>
    </footer>

  </div>
</Layout>

<style>
  .ess {
    background: var(--ess-paper);
    color: var(--ess-ink);
    font-family: var(--ess-serif);
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
  }

  .ess-wrap {
    max-width: 1220px;
    margin: 0 auto;
    padding-inline: var(--ess-gutter);
  }

  /* ---------- CAMADA 1: a espinha. Lidas sozinhas, contam a história. ---------- */
  .ess-display {
    font-family: var(--ess-serif);
    font-size: var(--ess-display);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.022em;
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
  }

  .ess-statement {
    font-family: var(--ess-serif);
    font-size: var(--ess-statement);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.016em;
    max-width: 20ch;
    margin: 0 0 clamp(2.25rem, 4vw, 3.25rem);
    text-wrap: pretty;
  }

  .ess-statement--light { color: var(--ess-paper); max-width: 22ch; }
  .ess-statement--close { max-width: 18ch; }

  /* ---------- CAMADA 2: rótulos de escaneio, na sans ---------- */
  .ess-label {
    font-family: var(--ess-sans);
    font-size: var(--ess-label);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ess-muted);
    margin: 0 0 1rem;
  }

  .ess-label--light { color: var(--ess-deep-tint); }

  /* ---------- CAMADA 3: prosa. Grande, escura, medida curta. ----------
     O erro da versão anterior foi corpo cinza a 17px. Aqui é 19–20px em
     quase-tinta, que é o que torna a leitura confortável de verdade. */
  .ess-read-text {
    font-size: var(--ess-read);
    font-weight: 400;
    line-height: 1.62;
    color: var(--ess-ink-soft);
    max-width: 58ch;
    margin: 0 0 1.15rem;
  }

  .ess-read-text:last-child { margin-bottom: 0; }

  /* A entrada em negrito dá ao olho um ponto de pouso por parágrafo. */
  .ess-read-text strong {
    font-weight: 600;
    color: var(--ess-ink);
  }

  .ess-read-text em {
    font-style: italic;
    color: var(--ess-ink);
  }

  .ess-read-text--lead { font-size: clamp(1.2rem, 1.6vw, 1.4rem); line-height: 1.55; }
  .ess-read-text--sm { font-size: 1.0625rem; line-height: 1.6; }
  .ess-read-text--light { color: var(--ess-deep-tint); }
  .ess-read-text--light strong,
  .ess-read-text--light em { color: var(--ess-paper); }
  .ess-read-text--after { margin-top: clamp(2.5rem, 4vw, 3.5rem); max-width: 54ch; }

  /* ---------- TOPO ---------- */
  .ess-top {
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--ess-rule-soft);
  }

  .ess-top-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .ess-mark {
    font-family: var(--ess-serif);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ess-ink);
    text-decoration: none;
  }

  .ess-top-meta {
    font-family: var(--ess-sans);
    font-size: var(--ess-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ess-muted);
  }

  .ess-top-link {
    font-family: var(--ess-sans);
    font-size: var(--ess-small);
    font-weight: 600;
    color: var(--ess-ink);
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--ess-rule);
    transition: text-decoration-color 200ms var(--ess-ease);
  }

  .ess-top-link:hover { text-decoration-color: var(--ess-ink); }

  /* ---------- 01 ABERTURA ---------- */
  .ess-open { padding-block: clamp(3.5rem, 7vw, 6rem) var(--ess-section); }

  .ess-open-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    row-gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .ess-open-col { grid-column: 1 / 8; }

  .ess-portrait { margin: 0; }

  .ess-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: var(--ess-paper-deep);
  }

  .ess-portrait figcaption {
    font-family: var(--ess-sans);
    font-size: var(--ess-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ess-muted);
    margin-top: 0.85rem;
  }

  .ess-portrait--lead { grid-column: 8 / 13; }

  /* ---------- 02 SINAIS ----------
     Cada item é um ponto de parada do olho: linha em serifa quase-tinta,
     mecanismo em sans pequena. O contraste de família separa as camadas. */
  .ess-signs { padding-block: 0 var(--ess-section); }

  .ess-signs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid var(--ess-ink);
  }

  .ess-sign {
    padding-block: clamp(1.3rem, 2.2vw, 1.75rem);
    border-bottom: 1px solid var(--ess-rule-soft);
  }

  .ess-sign-line {
    font-family: var(--ess-serif);
    font-size: var(--ess-sign);
    font-weight: 400;
    line-height: 1.38;
    letter-spacing: -0.008em;
    color: var(--ess-ink);
    margin: 0 0 0.4rem;
  }

  .ess-sign-cause {
    font-family: var(--ess-sans);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--ess-muted);
    margin: 0;
  }

  /* ---------- 03 A INVERSÃO ---------- */
  .ess-reveal {
    background: var(--ess-deep);
    color: var(--ess-paper);
    padding-block: clamp(4.5rem, 8vw, 7rem);
    margin-bottom: var(--ess-section);
  }

  .ess-reveal-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    max-width: 62rem;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--ess-deep-rule);
  }

  /* ---------- 04 TRÊS QUADROS ---------- */
  .ess-types { padding-block: 0 var(--ess-section); }

  .ess-types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .ess-type {
    border-top: 2px solid var(--ess-ink);
    padding-top: 1.15rem;
  }

  .ess-type-n {
    font-family: var(--ess-sans);
    font-size: var(--ess-label);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.14em;
    color: var(--ess-muted);
    margin: 0 0 1.25rem;
  }

  .ess-type-name {
    font-family: var(--ess-serif);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 0.3rem;
  }

  .ess-type-sum {
    font-family: var(--ess-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ess-ink);
    margin: 0 0 0.9rem;
  }

  /* ---------- 05 QUEM ATENDE ---------- */
  .ess-about { padding-block: 0 var(--ess-section); }

  .ess-about-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    row-gap: 2.5rem;
    align-items: start;
  }

  .ess-portrait--about { grid-column: 1 / 5; }
  .ess-about-text { grid-column: 6 / 13; }

  .ess-creds {
    margin: 2.25rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ess-rule);
    display: grid;
    gap: 0.75rem;
  }

  .ess-creds > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .ess-creds dt {
    font-family: var(--ess-sans);
    font-size: var(--ess-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ess-muted);
  }

  .ess-creds dd {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ess-ink-soft);
  }

  /* ---------- 06 A CONSULTA ---------- */
  .ess-visit { padding-block: 0 var(--ess-section); }

  .ess-visit-list { margin: 0; max-width: 62rem; }

  .ess-visit-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--ess-rule-soft);
  }

  .ess-visit-row:first-child { border-top: 1px solid var(--ess-ink); }

  .ess-visit-row dt {
    font-family: var(--ess-sans);
    font-size: var(--ess-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ess-muted);
    padding-top: 0.42rem;
  }

  .ess-visit-row dd {
    margin: 0;
    font-size: var(--ess-read);
    line-height: 1.55;
    color: var(--ess-ink-soft);
    max-width: 54ch;
  }

  .ess-limits {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--ess-paper-warm);
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    max-width: 62rem;
  }

  .ess-limits .ess-label { margin-bottom: 1.25rem; }

  .ess-limits-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem clamp(2rem, 5vw, 3.5rem);
  }

  .ess-limits-list li {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ess-ink-soft);
  }

  /* ---------- 07 DISPONIBILIDADE ---------- */
  .ess-close { padding-block: 0 var(--ess-section); }

  .ess-close-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
