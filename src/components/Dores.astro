---
// src/components/Dores.astro
---
<section id="sinais" class="vs-section vs-dores" aria-label="Sintomas e Dores">
  <div class="vs-dores__inner">
    <div class="vs-dores__header">
      <p class="vs-dores__overline vs-reveal">Os sinais do seu corpo</p>
      <h2 class="vs-dores__title vs-reveal" data-delay="1">A dor orofacial é silenciosa para os outros, mas sufocante para você.</h2>
      <p class="vs-reveal" data-delay="2" style="color: var(--color-text-secondary); font-size: var(--text-lg); font-weight: 300;">
        A DTM se disfarça e você se acostuma com ela sem perceber. Marque os sintomas que fazem parte da sua rotina e veja seu nível de DTM:
      </p>
    </div>

    <div class="vs-dores__grid" id="vs-symptom-grid">
      <div class="vs-dor-card vs-reveal" data-delay="1">
        <span class="vs-dor-card__check">
          <svg width="14" height="14" viewBox="0 0 24 24">
            <use href="#icon-check" />
          </svg>
        </span>
        <div class="vs-dor-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
            <path d="M12 7v5"></path>
            <path d="M12 16h.01"></path>
          </svg>
        </div>
        <h3 class="vs-dor-card__title">Dores de cabeça</h3>
        <p class="vs-dor-card__desc">Frequentes, constantes, especialmente ao acordar ou no fim do dia.</p>
      </div>
      <div class="vs-dor-card vs-reveal" data-delay="2">
        <span class="vs-dor-card__check">
          <svg width="14" height="14" viewBox="0 0 24 24">
            <use href="#icon-check" />
          </svg>
        </span>
        <div class="vs-dor-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </div>
        <h3 class="vs-dor-card__title">Estalos na mandíbula</h3>
        <p class="vs-dor-card__desc">Sensação de "areia" ou barulho alto ao abrir e fechar a boca.</p>
      </div>
      <div class="vs-dor-card vs-reveal" data-delay="3">
        <span class="vs-dor-card__check">
          <svg width="14" height="14" viewBox="0 0 24 24">
            <use href="#icon-check" />
          </svg>
        </span>
        <div class="vs-dor-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="vs-dor-card__title">Travamento facial</h3>
        <p class="vs-dor-card__desc">Dificuldade de abrir a boca totalmente para morder uma maçã ou bocejar.</p>
      </div>
      <div class="vs-dor-card vs-reveal" data-delay="1">
        <span class="vs-dor-card__check">
          <svg width="14" height="14" viewBox="0 0 24 24">
            <use href="#icon-check" />
          </svg>
        </span>
        <div class="vs-dor-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8.5a6.5 6.5 0 1 1 13 0c0 6-6 6-6 10a3 3 0 1 1-6 0"></path>
            <path d="M15 8.5a2.5 2.5 0 0 0-5 0v1"></path>
          </svg>
        </div>
        <h3 class="vs-dor-card__title">Zumbido no ouvido</h3>
        <p class="vs-dor-card__desc">Ou sensação de ouvido tampado, mesmo com exames otorrinos normais.</p>
      </div>
      <div class="vs-dor-card vs-reveal" data-delay="2">
        <span class="vs-dor-card__check">
          <svg width="14" height="14" viewBox="0 0 24 24">
            <use href="#icon-check" />
          </svg>
        </span>
        <div class="vs-dor-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.5 3 6.5 1 2 1 3.5 1 5a4 4 0 1 1-7.5-2z"></path>
          </svg>
        </div>
        <h3 class="vs-dor-card__title">Cansaço muscular</h3>
        <p class="vs-dor-card__desc">Sensação de rosto pesado ou dor radiando para pescoço e ombros.</p>
      </div>
      <div class="vs-dor-card vs-reveal" data-delay="3">
        <span class="vs-dor-card__check">
          <svg width="14" height="14" viewBox="0 0 24 24">
            <use href="#icon-check" />
          </svg>
        </span>
        <div class="vs-dor-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 10c0-5 3-7 7-7s7 2 7 7v2a7 7 0 0 1-7 7 7 7 0 0 1-7-7v-2Z"></path>
            <path d="M8 21v-2"></path>
            <path d="M16 21v-2"></path>
          </svg>
        </div>
        <h3 class="vs-dor-card__title">Dor de dente somática</h3>
        <p class="vs-dor-card__desc">Dores latejantes nos dentes sem que exista nenhuma cárie aparente.</p>
      </div>
    </div>

    <!-- DTM Gauge -->
    <div class="vs-dtm-gauge vs-reveal" data-delay="4">
      <p class="vs-dtm-gauge__label">Seu nível de DTM</p>
      <div class="vs-dtm-gauge__bar-wrap">
        <div class="vs-dtm-gauge__bar-fill" id="vs-gauge-fill"></div>
      </div>
      <div class="vs-dtm-gauge__levels">
        <span class="vs-dtm-gauge__level" data-lvl="1">DTM Silenciosa<br><small>1–2 sintomas</small></span>
        <span class="vs-dtm-gauge__level" data-lvl="2">DTM Avançada<br><small>3–4 sintomas</small></span>
        <span class="vs-dtm-gauge__level" data-lvl="3">DTM Grave<br><small>5–6 sintomas</small></span>
      </div>
      <p class="vs-dtm-gauge__result" id="vs-gauge-result">Marque seus sintomas e veja o resultado</p>

      <div class="vs-dtm-alert" id="vs-dtm-alert">
        <p class="vs-dtm-alert__text">
          Se você marcou <strong>2 ou mais</strong>, sua ATM pode estar mandando um alerta há muito tempo.
          A boa notícia: <strong>isso tem diagnóstico e tratamento.</strong>
        </p>
        <a href="https://wa.me/5532998513101?text=Ol%C3%A1%2C%20marquei%20sintomas%20no%20site%20e%20gostaria%20de%20ser%20avaliada(o)." target="_blank" rel="noopener" class="vs-btn vs-btn--primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <use href="#icon-whatsapp" />
          </svg>
          Quero ser avaliada(o)
        </a>
      </div>
    </div>
    <div style="text-align: center; margin-top: var(--space-12);" class="vs-reveal" data-delay="5">
      <a href="#resgate" class="vs-btn vs-btn--secondary">
        Quer entender mais?
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;">
          <path d="M12 5v14M19 12l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Script scoped no cliente pelo Astro
  const grid = document.getElementById('vs-symptom-grid');
  const fill = document.getElementById('vs-gauge-fill');
  const result = document.getElementById('vs-gauge-result');
  const alertEl = document.getElementById('vs-dtm-alert');
  const levels = document.querySelectorAll('.vs-dtm-gauge__level');

  if (grid && fill && result && alertEl) {
    grid.addEventListener('click', function (e) {
      const card = e.target.closest('.vs-dor-card');
      if (!card) return;
      card.classList.toggle('is-checked');
      updateGauge();
    });

    function updateGauge() {
      const count = grid.querySelectorAll('.vs-dor-card.is-checked').length;
      const pct = Math.round((count / 6) * 100);
      let lvl = 0;
      let label = 'Marque seus sintomas e veja o resultado';

      if (count >= 5) { lvl = 3; label = 'DTM Grave — Procure avaliação urgente'; }
      else if (count >= 3) { lvl = 2; label = 'DTM Avançada — Atenção redobrada'; }
      else if (count >= 1) { lvl = 1; label = 'DTM Silenciosa — Fique atenta(o)'; }

      fill.style.width = pct + '%';
      fill.setAttribute('data-level', lvl);
      result.textContent = label;
      result.setAttribute('data-level', lvl);

      levels.forEach(function (el) { el.classList.remove('is-active'); });
      if (lvl > 0) {
        levels.forEach(function (el) {
          if (parseInt(el.getAttribute('data-lvl')) === lvl) el.classList.add('is-active');
        });
      }

      if (count >= 2) { alertEl.classList.add('is-visible'); }
      else { alertEl.classList.remove('is-visible'); }
    }
  }
</script>

<style>
  .vs-dores {
    background: var(--color-cream);
    padding: var(--space-16) 0;
  }

  .vs-dores__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--side-padding);
  }

  .vs-dores__header {
    text-align: center;
    margin-bottom: var(--space-10);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .vs-dores__overline {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: var(--space-4);
  }

  .vs-dores__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .vs-dores__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .vs-dor-card {
    background: rgba(255, 255, 255, 0.6);
    border: 2px solid rgba(232, 122, 47, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform var(--duration-fast), box-shadow var(--duration-fast), border-color var(--duration-fast), background var(--duration-fast);
    cursor: pointer;
    position: relative;
    user-select: none;
  }

  .vs-dor-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    background: rgba(255, 255, 255, 0.9);
  }

  .vs-dor-card.is-checked {
    border-color: var(--color-amber);
    background: rgba(232, 122, 47, 0.06);
    box-shadow: 0 0 0 3px rgba(232, 122, 47, 0.12);
  }

  .vs-dor-card.is-checked:hover {
    transform: translateY(-2px);
  }

  .vs-dor-card__check {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
    border: 2px solid rgba(0, 0, 0, 0.12);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast) var(--ease-spring);
  }

  .vs-dor-card__check svg {
    opacity: 0;
    transform: scale(0.5);
    transition: all var(--duration-fast) var(--ease-spring);
  }

  .vs-dor-card.is-checked .vs-dor-card__check {
    border-color: var(--color-amber);
    background: var(--color-amber);
  }

  .vs-dor-card.is-checked .vs-dor-card__check svg {
    opacity: 1;
    transform: scale(1);
  }

  .vs-dor-card__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-amber-subtle);
    color: var(--color-amber);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vs-dor-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .vs-dor-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: 300;
  }

  /* === DTM GAUGE === */
  .vs-dtm-gauge {
    margin-top: var(--space-10);
    padding: var(--space-8);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(232, 122, 47, 0.1);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .vs-dtm-gauge__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .vs-dtm-gauge__bar-wrap {
    position: relative;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--color-cream-dark);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }

  .vs-dtm-gauge__bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: var(--radius-full);
    background: var(--color-warm-gray);
    width: 0%;
    transition: width 0.5s var(--ease-out), background 0.5s var(--ease-out);
  }

  .vs-dtm-gauge__bar-fill[data-level="1"] {
    background: #7EC8E3;
  }

  .vs-dtm-gauge__bar-fill[data-level="2"] {
    background: var(--color-amber-light);
  }

  .vs-dtm-gauge__bar-fill[data-level="3"] {
    background: #D4613C;
  }

  .vs-dtm-gauge__levels {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .vs-dtm-gauge__level {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    transition: all var(--duration-fast);
    text-align: center;
  }

  .vs-dtm-gauge__level.is-active {
    color: white;
    font-weight: 600;
  }

  .vs-dtm-gauge__level.is-active[data-lvl="1"] {
    background: #7EC8E3;
  }

  .vs-dtm-gauge__level.is-active[data-lvl="2"] {
    background: var(--color-amber-light);
  }

  .vs-dtm-gauge__level.is-active[data-lvl="3"] {
    background: #D4613C;
  }

  .vs-dtm-gauge__result {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
    min-height: 1.5em;
    transition: color var(--duration-fast);
  }

  .vs-dtm-gauge__result[data-level="1"] {
    color: #5BA8C8;
  }

  .vs-dtm-gauge__result[data-level="2"] {
    color: var(--color-amber);
  }

  .vs-dtm-gauge__result[data-level="3"] {
    color: #D4613C;
  }

  /* === ALERT + CTA === */
  .vs-dtm-alert {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(232, 122, 47, 0.12);
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.4s var(--ease-out), max-height 0.4s var(--ease-out), margin 0.4s var(--ease-out);
  }

  .vs-dtm-alert.is-visible {
    opacity: 1;
    max-height: 200px;
  }

  .vs-dtm-alert__text {
    font-family: var(--font-accent);
    font-size: var(--text-base);
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .vs-dtm-alert__text strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .vs-dores__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .vs-dtm-gauge__levels {
      gap: var(--space-2);
    }
  }

  @media (max-width: 600px) {
    .vs-dores__grid {
      grid-template-columns: 1fr;
    }

    .vs-dores__title {
      font-size: var(--text-3xl);
    }

    .vs-dtm-gauge__levels {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2);
    }

    .vs-dtm-gauge {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>
