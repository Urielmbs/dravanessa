---
// src/components/Tratamentos.astro
---
<section id="tratamentos" class="vs-trats vs-section">
  <div class="vs-trats__inner">
    <div class="vs-trats__header">
      <p class="vs-trats__overline vs-reveal">Campos de Atuação</p>
      <h2 class="vs-trats__title vs-reveal" data-delay="1">Tratamentos de Alta Complexidade</h2>
      <p class="vs-trats__subtitle vs-reveal" data-delay="2">Procedimentos avançados com foco em resultado duradouro e qualidade de vida real.</p>
    </div>

    <!-- Subsection 1: DTM e Dor Orofacial -->
    <div class="vs-trats-sub vs-reveal" data-delay="1">
      <div class="vs-trats-sub__header">
        <div class="vs-trats-sub__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
            <path d="M12 7v5"></path>
            <path d="M12 16h.01"></path>
          </svg>
        </div>
        <div>
          <h3 class="vs-trats-sub__title">DTM e Dor Orofacial</h3>
          <p class="vs-trats-sub__label">Especialidade clínica e minimamente invasiva</p>
        </div>
      </div>

      <div class="vs-trats-sub__grid">
        <a href="/procedimentos/artrocentese" class="vs-proc-card vs-reveal" data-delay="1">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="m18 2 4 4"></path>
                <path d="m17 7 3-3"></path>
                <path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5"></path>
                <path d="m9 11 4 4"></path>
                <path d="m5 19-3 3"></path>
                <path d="m14 4 6 6"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Artrocentese da ATM</h4>
          </div>
          <p class="vs-proc-card__desc">Lavagem articular que remove debris inflamatórios e devolve mobilidade à mandíbula desde a primeira sessão.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>

        <a href="/procedimentos/viscosuplementacao" class="vs-proc-card vs-reveal" data-delay="2">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5s-3 3.5-3 5.5a7 7 0 0 0 7 7z"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Viscossuplementação</h4>
          </div>
          <p class="vs-proc-card__desc">Reposição do ácido hialurônico na ATM para reduzir atrito, nutrir a cartilagem e aliviar a dor articular crônica.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>

        <a href="/procedimentos/atm-conservador" class="vs-proc-card vs-reveal" data-delay="3">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                <path d="M5 3v4"></path>
                <path d="M19 17v4"></path>
                <path d="M3 5h4"></path>
                <path d="M17 19h4"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Tratamento Conservador & Regenerativo</h4>
          </div>
          <p class="vs-proc-card__desc">Protocolos biológicos e placas de alta precisão que estimulam o equilíbrio da ATM sem cirurgia.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>

        <a href="/procedimentos/liberacao-miofascial" class="vs-proc-card vs-reveal" data-delay="4">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
                <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v6"></path>
                <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
                <path d="M18 8a2 2 0 0 1 2 2v4a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.8-5.6-2.4L2.3 14.5a2 2 0 0 1 .4-2.8v0a2 2 0 0 1 2.8.4L7 14.5"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Liberação Miofascial</h4>
          </div>
          <p class="vs-proc-card__desc">Técnica terapêutica para desativação de pontos-gatilho (trigger points) na musculatura da face, cabeça e pescoço.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>
      </div>
    </div>

    <!-- Subsection 2: Especialidade Cirúrgica -->
    <div class="vs-trats-sub vs-reveal" data-delay="2">
      <div class="vs-trats-sub__header">
        <div class="vs-trats-sub__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
          </svg>
        </div>
        <div>
          <h3 class="vs-trats-sub__title">Especialidade Cirúrgica & Estomatologia</h3>
          <p class="vs-trats-sub__label">Cirurgia bucomaxilofacial de alta precisão</p>
        </div>
      </div>

      <div class="vs-trats-sub__grid">
        <a href="/procedimentos/cirurgia-ortognatica" class="vs-proc-card vs-reveal" data-delay="1">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20"></path>
                <path d="M2 12h20"></path>
                <path d="m15 5-3-3-3 3"></path>
                <path d="m15 19-3 3-3-3"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Cirurgia Ortognática</h4>
          </div>
          <p class="vs-proc-card__desc">Correção de deformidades ósseas da face para devolver harmonia estética, funcionalidade mastigatória e respiratória.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>

        <a href="/procedimentos/remocao-sisos" class="vs-proc-card vs-reveal" data-delay="2">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 10c0-5 3-7 7-7s7 2 7 7v2a7 7 0 0 1-7 7 7 7 0 0 1-7-7v-2Z"></path>
                <path d="M8 21v-2"></path>
                <path d="M16 21v-2"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Remoção de Sisos & Cirurgia Oral</h4>
          </div>
          <p class="vs-proc-card__desc">Extrações de sisos complexos e procedimentos ambulatoriais com técnica minimamente invasiva e rápida recuperação.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>

        <a href="/procedimentos/biopsias" class="vs-proc-card vs-reveal" data-delay="3">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
                <path d="M11 8v6"></path>
                <path d="M8 11h6"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Biópsias & Estomatologia</h4>
          </div>
          <p class="vs-proc-card__desc">Coleta e análise de tecidos bucais para diagnóstico preciso de lesões, garantindo tratamento adequado e seguro.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>

        <a href="/procedimentos/pacientes-oncologicos" class="vs-proc-card vs-reveal" data-delay="4">
          <div class="vs-proc-card__top">
            <div class="vs-proc-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
                <path d="M12 8v8"></path>
                <path d="M8 12h8"></path>
              </svg>
            </div>
            <h4 class="vs-proc-card__title">Pacientes Oncológicos & Especiais</h4>
          </div>
          <p class="vs-proc-card__desc">Acompanhamento e suporte bucomaxilofacial especializado durante todas as etapas do tratamento oncológico.</p>
          <span class="vs-proc-card__link">Saiba mais →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .vs-trats {
    background: var(--gradient-ice);
    padding: var(--space-16) 0;
  }

  .vs-trats__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--side-padding);
  }

  .vs-trats__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .vs-trats__overline {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: var(--space-4);
  }

  .vs-trats__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .vs-trats__subtitle {
    font-family: var(--font-accent);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Subsection block */
  .vs-trats-sub {
    margin-bottom: var(--space-12);
  }

  .vs-trats-sub:last-child {
    margin-bottom: 0;
  }

  .vs-trats-sub__header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid rgba(232, 122, 47, 0.12);
  }

  .vs-trats-sub__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    background: var(--gradient-warm);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 16px rgba(232, 122, 47, 0.25);
  }

  .vs-trats-sub__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .vs-trats-sub__label {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  /* 2x2 grid */
  .vs-trats-sub__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  /* Procedure card */
  .vs-proc-card {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(232, 122, 47, 0.06);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    position: relative;
    overflow: hidden;
    transition: transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal);
  }

  .vs-proc-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-amber);
    opacity: 0;
    transition: opacity var(--duration-normal);
  }

  .vs-proc-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(232, 122, 47, 0.15);
  }

  .vs-proc-card:hover::before {
    opacity: 1;
  }

  .vs-proc-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
    cursor: pointer;
  }

  .vs-proc-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-amber);
  }

  .vs-proc-card__top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .vs-proc-card__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-amber-subtle);
    color: var(--color-amber);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vs-proc-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .vs-proc-card__desc {
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    padding-left: calc(40px + var(--space-3));
  }

  .vs-proc-card__link {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-amber);
    padding-left: calc(40px + var(--space-3));
    transition: color var(--duration-fast) var(--ease-out);
  }

  .vs-proc-card:hover .vs-proc-card__link {
    color: var(--color-amber-light);
  }

  @media (max-width: 768px) {
    .vs-trats__title {
      font-size: var(--text-3xl);
    }

    .vs-trats-sub__grid {
      grid-template-columns: 1fr;
    }

    .vs-proc-card__desc,
    .vs-proc-card__link {
      padding-left: 0;
    }
  }
</style>
