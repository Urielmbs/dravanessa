---
// src/components/Hero.astro
import { siteConfig } from '../data/site';
---
<section class="vs-section vs-hero" aria-label="Apresentação principal">
  <!-- Background accents -->
  <div class="vs-hero__gradient"></div>
  <div class="vs-hero__accent vs-hero__accent--1"></div>
  <div class="vs-hero__accent vs-hero__accent--2"></div>
  <div class="vs-hero__accent vs-hero__accent--3"></div>

  <!-- Content -->
  <div class="vs-hero__content">
    <p class="vs-hero__overline vs-reveal">Dra. Vanessa Silveira</p>

    <h1 class="vs-hero__title vs-reveal" data-delay="1">
      Dor na mandíbula que ninguém explica? <em>Tem causa e tem tratamento.</em>
    </h1>

    <h2 class="vs-hero__subtitle vs-reveal" data-delay="2">
      Você não precisa conviver com estalos, dor de cabeça, mandíbula travada ou dente doendo sem cárie. A Dra. Vanessa Silveira, cirurgiã bucomaxilofacial, investiga a causa real da sua dor.
    </h2>

    <p class="vs-hero__locations vs-reveal" data-delay="2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />
      </svg>
      <span>Atendimento em <strong>Juiz de Fora</strong> e na <strong>Barra da Tijuca (RJ)</strong>.</span>
    </p>

    <div class="vs-hero__actions vs-reveal" data-delay="3">
      <a href={siteConfig.whatsapp.href} data-wa-origin="Agende sua consulta (topo da página)" target="_blank" rel="noopener" class="vs-btn vs-btn--primary">
        <svg class="vs-hero__whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
          <use href="#icon-whatsapp" />
        </svg>
        Agende sua consulta
      </a>
      <a href="/diagnosticos/auto-diagnostico#sinais" class="vs-btn vs-btn--secondary">
        Fazer o teste de sintomas
      </a>
    </div>
    <p class="vs-hero__note vs-reveal" data-delay="3">Atendimento particular</p>
  </div>

  <!-- Scroll indicator -->
  <a href="#pra-quem" class="vs-hero__scroll">
    <span class="vs-hero__scroll-line"></span>
    <span>Saiba mais</span>
  </a>

  <!-- Bottom wave transition -->
  <div class="vs-hero__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 80" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 32C240 64 480 80 720 64C960 48 1200 16 1440 32V80H0V32Z" fill="currentColor" />
    </svg>
  </div>
</section>

<style>
  .vs-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-cream);
  }

  /* Warm gradient background layer */
  .vs-hero__gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%, rgba(232, 122, 47, 0.25) 0%, transparent 70%),
      radial-gradient(ellipse 60% 50% at 70% 80%, rgba(245, 166, 35, 0.15) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 30% 90%, rgba(212, 97, 60, 0.1) 0%, transparent 50%);
    z-index: 1;
  }

  /* Organic wave decoration */
  .vs-hero__wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    z-index: 3;
    color: var(--color-cream-dark);
  }

  .vs-hero__wave svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Flowing organic shape accents */
  .vs-hero__accent {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    z-index: 1;
  }

  .vs-hero__accent--1 {
    width: 500px;
    height: 500px;
    background: var(--color-amber-soft);
    top: -150px;
    right: -100px;
  }

  .vs-hero__accent--2 {
    width: 400px;
    height: 400px;
    background: var(--color-ice-deep);
    bottom: 10%;
    left: -120px;
  }

  .vs-hero__accent--3 {
    width: 300px;
    height: 300px;
    background: var(--color-amber-light);
    bottom: -50px;
    right: 20%;
    opacity: 0.25;
  }

  .vs-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: var(--space-20) var(--side-padding) var(--space-16);
    max-width: 1100px;
  }

  .vs-hero__overline {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .vs-hero__overline::before,
  .vs-hero__overline::after {
    content: '';
    width: 24px;
    height: 1.5px;
    background: var(--color-amber);
    display: block;
  }

  .vs-hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.6vw, 4.25rem);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    text-wrap: balance;
  }

  .vs-hero__title em {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    color: var(--color-amber);
  }

  .vs-hero__subtitle {
    font-family: var(--font-accent);
    font-size: var(--text-lg);
    font-weight: 400;
    font-style: italic;
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    max-width: 760px;
    margin: 0 auto var(--space-5);
  }

  .vs-hero__locations {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0 auto var(--space-8);
    padding: 8px 18px;
    background: var(--color-amber-subtle);
    border: 1px solid rgba(232, 122, 47, 0.25);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .vs-hero__locations svg {
    color: var(--color-amber);
    flex-shrink: 0;
  }

  .vs-hero__locations strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .vs-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .vs-hero__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* WhatsApp icon in button */
  .vs-hero__whatsapp-icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Scroll indicator */
  .vs-hero__scroll {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-family: var(--font-body);
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: color var(--duration-fast), transform var(--duration-fast);
  }

  .vs-hero__scroll:hover {
    color: var(--color-amber);
    transform: translateX(-50%) translateY(-5px);
  }

  .vs-hero__scroll-line {
    width: 1px;
    height: 32px;
    background: var(--color-amber);
    animation: vs-scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes vs-scroll-pulse {
    0%, 100% {
      opacity: 0.3;
      transform: scaleY(0.6);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  /* === RESPONSIVIDADE === */
  @media (max-width: 768px) {
    .vs-hero {
      min-height: 90vh;
    }

    .vs-hero__content {
      padding: var(--space-16) var(--side-padding) var(--space-12);
    }

    .vs-hero__title {
      font-size: clamp(2.5rem, 10vw, 3.5rem);
    }

    .vs-hero__subtitle {
      font-size: var(--text-base);
    }

    .vs-hero__accent--1 {
      width: 300px;
      height: 300px;
    }

    .vs-hero__accent--2 {
      width: 250px;
      height: 250px;
    }

    .vs-hero__scroll {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .vs-hero__actions {
      flex-direction: column;
      width: 100%;
    }

    .vs-hero__actions .vs-btn {
      width: 100%;
    }
  }
</style>
