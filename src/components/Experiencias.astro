---
// src/components/Experiencias.astro
---
<section class="vs-section vs-experiencias" aria-label="Experiências Profissionais">
  <div class="vs-experiencias__inner">
    <p class="vs-experiencias__label vs-reveal">Experiência Profissional</p>
    <div class="vs-experiencias__grid">
      <div class="vs-exp-item vs-reveal" data-delay="1">
        <div class="vs-exp-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21h18"></path>
            <path d="M21 21V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14"></path>
            <path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"></path>
            <path d="M10 9h4"></path>
            <path d="M12 7v4"></path>
          </svg>
        </div>
        <p class="vs-exp-item__title">Hospital</p>
        <p class="vs-exp-item__desc">Cirurgias Hospitalares</p>
      </div>
      <div class="vs-exp-item vs-reveal" data-delay="2">
        <div class="vs-exp-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </div>
        <p class="vs-exp-item__title">Pesquisadora</p>
        <p class="vs-exp-item__desc">Inovação em Saúde</p>
      </div>
      <div class="vs-exp-item vs-reveal" data-delay="3">
        <div class="vs-exp-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <p class="vs-exp-item__title">Gestão</p>
        <p class="vs-exp-item__desc">Clínica e Hospitalar</p>
      </div>
      <div class="vs-exp-item vs-reveal" data-delay="4">
        <div class="vs-exp-item__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <p class="vs-exp-item__title">Docência</p>
        <p class="vs-exp-item__desc">Graduação e Pós</p>
      </div>
    </div>
  </div>
</section>

<style>
  .vs-experiencias {
    background: var(--color-cream-dark);
    padding: var(--space-10) 0;
  }

  .vs-experiencias__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--side-padding);
  }

  .vs-experiencias__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-amber);
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .vs-experiencias__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .vs-exp-item {
    text-align: center;
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(232, 122, 47, 0.06);
    transition: transform var(--duration-fast), box-shadow var(--duration-fast);
  }

  .vs-exp-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .vs-exp-item__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-amber-subtle);
    color: var(--color-amber);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-3);
  }

  .vs-exp-item__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .vs-exp-item__desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .vs-experiencias__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .vs-experiencias__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
