---
// src/components/WhatsAppFloat.astro
// Botão fixo de WhatsApp — visível durante toda a rolagem, em todas as páginas.
// Nas landing pages recebe `href` com a mensagem fixa da campanha (sem a
// mensagem dinâmica de data-wa-origin), `lpCta` para o rastreamento e
// `mobileOnly` para aparecer só no celular.
import { siteConfig } from '../data/site';

interface Props {
  href?: string;
  lpCta?: string;
  mobileOnly?: boolean;
}

const { href, lpCta, mobileOnly = false } = Astro.props;
---
<a href={href ?? siteConfig.whatsapp.href} data-wa-origin={href ? undefined : 'whatsapp'} data-lp-cta={lpCta}
  target="_blank" rel="noopener" class:list={['vs-wa-float', { 'vs-wa-float--mobile-only': mobileOnly }]} id="vs-wa-float"
  aria-label="Falar com a Dra. Vanessa Silveira pelo WhatsApp">
  <svg class="vs-wa-float__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <use href="#icon-whatsapp" />
  </svg>
</a>

<script>
  // Links com data-wa-origin recebem mensagem com o nome da página atual e o botão de origem.
  const applyDynamicWhatsAppMessage = () => {
    const pageName = document.title.split('|')[0].trim();
    document.querySelectorAll<HTMLAnchorElement>('a[data-wa-origin]').forEach((a) => {
      const origin = a.dataset.waOrigin;
      const button = origin === 'whatsapp' ? origin : `"${origin}"`;
      const message = `Olá, estava na página ${pageName} no site da Dra. Vanessa e entrei em contato pelo botão ${button}.`;
      const base = a.href.split('?')[0];
      a.href = `${base}?text=${encodeURIComponent(message)}`;
    });
  };

  const initWhatsAppFloat = () => {
    applyDynamicWhatsAppMessage();
    const btn = document.getElementById('vs-wa-float');
    if (!btn) return;

    const toggleVisibility = () => {
      btn.classList.toggle('is-visible', window.scrollY > 400);
    };

    toggleVisibility();
    window.addEventListener('scroll', toggleVisibility, { passive: true });
  };

  initWhatsAppFloat();
  document.addEventListener('astro:after-swap', initWhatsAppFloat);
</script>

<style>
  .vs-wa-float {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35);
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-spring);
  }

  .vs-wa-float.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .vs-wa-float:hover {
    background: #1EBE5A;
  }

  .vs-wa-float__icon {
    width: 28px;
    height: 28px;
  }

  @media (min-width: 768px) {
    .vs-wa-float--mobile-only {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-wa-float {
      transition: opacity var(--duration-fast);
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .vs-wa-float {
      right: var(--space-4);
      bottom: var(--space-4);
      width: 52px;
      height: 52px;
    }

    .vs-wa-float__icon {
      width: 26px;
      height: 26px;
    }
  }
</style>
