---
// src/components/Footer.astro
import { siteConfig } from '../data/site';
---

<!-- Pre-Footer Call To Action -->
<section class="vs-footer-cta">
  <div class="vs-container vs-footer-cta__inner">
    <div>
      <h3 class="vs-footer-cta__title">Pronto para viver sem dor e recuperar sua qualidade de vida?</h3>
      <p class="vs-footer-cta__desc">Agende sua avaliação especializada com a Dra. Vanessa Silveira em Juiz de Fora.</p>
    </div>
    <a href={siteConfig.whatsapp.href} target="_blank" rel="noopener" class="vs-btn vs-btn--primary vs-footer-cta__btn">Fale conosco pelo WhatsApp</a>
  </div>
</section>

<!-- Main Monumental Footer -->
<footer class="vs-footer" aria-label="Rodapé Principal">
  <div class="vs-container">
    <!-- Top 4 Columns Grid -->
    <div class="vs-footer__columns">
      <!-- Col 1: Dra. Vanessa -->
      <div>
        <h4 class="vs-footer__col-title">Dra. Vanessa</h4>
        <ul class="vs-footer__col-list">
          <li><a href="/" class="footer-link-hover">Página Inicial</a></li>
          <li><a href="/dra-vanessa" class="footer-link-hover">Sobre a Dra. Vanessa</a></li>
          <li><a href="/treinamentos" class="footer-link-hover">Treinamentos & Cursos</a></li>
          <li><a href="/eventos" class="footer-link-hover">Eventos & Palestras</a></li>
        </ul>
      </div>

      <!-- Col 2: Sintomas & Dores -->
      <div>
        <h4 class="vs-footer__col-title">Sintomas & Dores</h4>
        <ul class="vs-footer__col-list">
          <li><a href="/sintomas/dor-atm-estalos" class="footer-link-hover">Dores na ATM & Estalos</a></li>
          <li><a href="/sintomas/bruxismo-apertamento" class="footer-link-hover">Bruxismo & Dor de Cabeça</a></li>
          <li><a href="/sintomas/deformidade-mordida" class="footer-link-hover">Deformidades Faciais</a></li>
          <li><a href="/sintomas/sisos-lesoes" class="footer-link-hover">Sisos & Lesões Bucais</a></li>
          <li><a href="/diagnosticos/auto-diagnostico" class="footer-link-hover vs-footer__col-list-item--highlight">🩻 Auto-Diagnóstico DTM</a></li>
        </ul>
      </div>

      <!-- Col 3: Tratamentos -->
      <div>
        <h4 class="vs-footer__col-title">Tratamentos</h4>
        <ul class="vs-footer__col-list">
          <li><a href="/procedimentos/artrocentese" class="footer-link-hover">Artrocentese da ATM</a></li>
          <li><a href="/procedimentos/viscosuplementacao" class="footer-link-hover">Viscossuplementação</a></li>
          <li><a href="/procedimentos/liberacao-miofascial" class="footer-link-hover">Liberação Miofascial</a></li>
          <li><a href="/procedimentos/atm-conservador" class="footer-link-hover">Tratamento Conservador</a></li>
          <li><a href="/procedimentos/cirurgia-ortognatica" class="footer-link-hover">Cirurgia Ortognática</a></li>
          <li><a href="/procedimentos/remocao-sisos" class="footer-link-hover">Remoção de Sisos</a></li>
          <li><a href="/procedimentos/biopsias" class="footer-link-hover">Biópsias & Estomatologia</a></li>
        </ul>
      </div>

      <!-- Col 4: Atendimento -->
      <div>
        <h4 class="vs-footer__col-title">Atendimento</h4>
        <div class="vs-footer__contact">
          <p class="vs-footer__contact-primary">📞 {siteConfig.whatsapp.display}</p>
          <p class="vs-footer__contact-line">✉️ {siteConfig.email}</p>
          <div class="vs-footer__contact-address">
            <p class="vs-footer__contact-line">📍 <strong class="vs-footer__contact-clinic">{siteConfig.address.clinic}</strong></p>
            <p class="vs-footer__contact-line">{siteConfig.address.street}</p>
            <p class="vs-footer__contact-line">{siteConfig.address.cityLine}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Gradient Divider Line -->
    <div class="vs-footer__divider"></div>

    <!-- Bottom Giant Brand Block -->
    <div class="vs-footer__brand">
      <p class="vs-footer__brand-name">
        DRA. VANESSA SILVEIRA
      </p>
      <p class="vs-footer__brand-tagline">
        Cirurgiã Bucomaxilofacial · DTM, Dor de Cabeça, Bruxismo & Cirurgias. Você não precisa mais conviver com a dor, vamos tratar ela juntos.
      </p>

      <div class="vs-footer__brand-social">
        <span class="vs-footer__cro-badge">
          {siteConfig.cro} | Especialista Bucomaxilofacial
        </span>
        <div class="vs-footer__social-links">
          <a href={siteConfig.social.instagram} target="_blank" rel="noopener" class="footer-btn-hover">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="5" />
              <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none" />
            </svg>
            <span>Instagram</span>
          </a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener" class="footer-btn-hover">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
          <a href={siteConfig.social.youtube} target="_blank" rel="noopener" class="footer-btn-hover">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>YouTube</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="vs-footer__legal">
      <p class="vs-footer__legal-copy">© 2026 Dra. Vanessa Silveira. Todos os direitos reservados.</p>
      <div class="vs-footer__legal-links">
        <a href="/politica-de-privacidade">Política de Privacidade</a>
        <span>•</span>
        <a href="/termos-de-uso">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .vs-footer-cta {
    background: #b2c9db;
    padding: 40px 0;
    border-bottom: 1px solid #9eb8cd;
    color: #0f172a;
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .vs-footer-cta__title {
    font-family: var(--font-display), 'Outfit', sans-serif;
    font-size: 24px;
    color: #0f172a;
    margin-bottom: 6px;
    font-weight: 700;
  }

  .vs-footer-cta__desc {
    font-family: var(--font-body), 'Outfit', sans-serif;
    font-size: 15px;
    color: #334155;
    margin: 0;
    line-height: 1.5;
  }

  .vs-footer-cta__btn {
    box-shadow: 0 4px 14px rgba(232, 122, 47, 0.4);
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer {
    background-color: #c5d7e5;
    color: #1e293b;
    padding: 64px 0 40px;
    font-family: var(--font-body), 'Outfit', sans-serif;
    border-top: 1px solid #b2c9db;
  }

  .vs-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 36px;
    margin-bottom: 40px;
  }

  .vs-footer__col-title {
    font-family: var(--font-display), 'Outfit', sans-serif;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #0f172a;
    margin-bottom: 20px;
    border-bottom: 2px solid #e87a2f;
    padding-bottom: 8px;
    display: inline-block;
    font-weight: 700;
  }

  .vs-footer__col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vs-footer__col-list a {
    color: #334155;
    text-decoration: none;
    font-size: 14px;
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer__col-list-item--highlight a,
  .vs-footer__col-list a.vs-footer__col-list-item--highlight {
    color: #c25e1a;
    font-weight: 700;
  }

  .vs-footer__contact {
    font-size: 14px;
    line-height: 1.6;
    color: #334155;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer__contact-primary {
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .vs-footer__contact-line {
    margin: 0;
  }

  .vs-footer__contact-address {
    margin-top: 4px;
  }

  .vs-footer__contact-clinic {
    color: #0f172a;
  }

  .vs-footer__divider {
    height: 1px;
    background: linear-gradient(90deg, rgba(232, 122, 47, 0.5), rgba(15, 23, 42, 0.15), rgba(232, 122, 47, 0.5));
    margin: 48px 0;
  }

  .vs-footer__brand {
    text-align: center;
    padding: 20px 0 32px;
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer__brand-name {
    font-family: var(--font-display), 'Outfit', sans-serif;
    font-size: clamp(2.2rem, 6.5vw, 5.5rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin: 0 0 16px 0;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.05;
  }

  .vs-footer__brand-tagline {
    font-family: var(--font-body), 'Outfit', sans-serif;
    font-size: clamp(14px, 1.8vw, 17px);
    color: #334155;
    max-width: 760px;
    margin: 0 auto 24px;
    line-height: 1.6;
    font-weight: 500;
    text-align: center;
  }

  .vs-footer__brand-social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .vs-footer__cro-badge {
    display: inline-block;
    padding: 8px 18px;
    background: rgba(232, 122, 47, 0.15);
    border: 1px solid rgba(232, 122, 47, 0.4);
    border-radius: 30px;
    font-size: 12px;
    color: #c25e1a;
    font-weight: 700;
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer__social-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .vs-footer__social-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 30px;
    background: rgba(15, 23, 42, 0.06);
    border: 1px solid rgba(15, 23, 42, 0.18);
    color: #0f172a;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer__legal {
    border-top: 1px solid rgba(15, 23, 42, 0.15);
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: #475569;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-body), 'Outfit', sans-serif;
  }

  .vs-footer__legal-copy {
    margin: 0;
  }

  .vs-footer__legal-links {
    display: flex;
    gap: 12px;
  }

  .vs-footer__legal-links a {
    color: #475569;
    text-decoration: none;
  }

  .footer-link-hover {
    transition: all 0.2s ease;
  }
  .footer-link-hover:hover {
    color: #e87a2f;
    transform: translateX(4px);
  }
  .footer-btn-hover {
    transition: all 0.2s ease;
  }
  .footer-btn-hover:hover {
    background: #e87a2f;
    border-color: #e87a2f;
    color: #ffffff;
    transform: translateY(-2px);
  }
</style>
