          <li><a href="/sintomas/bruxismo-apertamento">Bruxismo & Dor de Cabeça</a></li>
          <li><a href="/sintomas/deformidade-mordida">Deformidades & Mordida</a></li>
          <li><a href="/sintomas/sisos-lesoes">Sisos & Lesões Bucais</a></li>
          <li><a href="/diagnosticos/auto-diagnostico" style="color: var(--color-amber); font-weight: 600;">✨ Auto-Diagnóstico DTM</a></li>
        </ul>
      </div>

      <!-- Soluções & Tratamentos -->
      <div>
        <p class="vs-footer__col-title">Tratamentos</p>
        <ul class="vs-footer__links">
          <li><a href="/procedimentos/artrocentese">Artrocentese da ATM</a></li>
          <li><a href="/procedimentos/viscosuplementacao">Viscossuplementação</a></li>
          <li><a href="/procedimentos/liberacao-miofascial">Liberação Miofascial</a></li>
          <li><a href="/procedimentos/atm-conservador">Tratamento Conservador</a></li>
          <li><a href="/procedimentos/cirurgia-ortognatica">Cirurgia Ortognática</a></li>
          <li><a href="/procedimentos/remocao-sisos">Remoção de Sisos</a></li>
          <li><a href="/procedimentos/biopsias">Biópsias & Estomatologia</a></li>
        </ul>
      </div>

      <!-- Contato -->
      <div>
        <p class="vs-footer__col-title">Contato</p>
        <ul class="vs-footer__links">
          <li><a href="https://wa.me/5532998513101">(32) 99851-3101</a></li>
          <li><a href="mailto:vanessa@zaidansilveira.com.br">vanessa@zaidansilveira.com.br</a></li>
          <li><a href="https://maps.google.com/?q=Av+Presidente+Itamar+Franco+1545+Juiz+de+Fora" target="_blank" rel="noopener">SINPLA Odontologia<br>Av. Pres. Itamar Franco, 1545, Sala 1<br>Centro, Juiz de Fora - MG</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="vs-footer__bottom">
      <p class="vs-footer__copy">© 2026 Dra. Vanessa Silveira. Todos os direitos reservados.</p>
      <div class="vs-footer__legal">
        <a href="/politica-de-privacidade">Política de Privacidade</a>
        <a href="/termos-de-uso">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .vs-footer {
    background: var(--color-ice);
    padding: var(--space-10) 0 var(--space-6);
  }

  .vs-footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--side-padding);
  }

  .vs-footer__main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
  }

  /* Brand column */
  .vs-footer__brand-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .vs-footer__brand-desc {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    font-weight: 400;
    font-style: italic;
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
    max-width: 280px;
  }

  .vs-footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .vs-footer__social-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(26, 26, 26, 0.04);
    border: 1px solid rgba(26, 26, 26, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    transition: background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
    text-decoration: none;
  }

  .vs-footer__social-link:hover {
    background: var(--color-amber);
    color: #FFFFFF !important;
    border-color: var(--color-amber);
  }

  .vs-footer__social-link svg {
    width: 18px;
    height: 18px;
  }

  /* Nav columns */
  .vs-footer__col-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .vs-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .vs-footer__links a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-secondary) !important;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .vs-footer__links a:hover {
    color: var(--color-amber) !important;
  }

  /* Bottom bar */
  .vs-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .vs-footer__copy {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-muted);
  }

  .vs-footer__legal {
    display: flex;
    gap: var(--space-4);
  }

  .vs-footer__legal a {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-text-muted) !important;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .vs-footer__legal a:hover {
    color: var(--color-text-secondary) !important;
  }

  /* === RESPONSIVIDADE === */
  @media (max-width: 768px) {
    .vs-footer__main {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .vs-footer__brand {
      grid-column: 1 / -1;
    }

    .vs-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .vs-footer__main {
      grid-template-columns: 1fr;
    }
  }
</style>
