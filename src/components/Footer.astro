        <p class="vs-footer__col-title">Dra. Vanessa</p>
        <ul class="vs-footer__links">
          <li><a href="/">Página Inicial</a></li>
          <li><a href="/dra-vanessa">Sobre a Dra. Vanessa</a></li>
          <li><a href="/treinamentos">Treinamentos & Cursos</a></li>
