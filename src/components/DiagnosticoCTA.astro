---
// src/components/DiagnosticoCTA.astro
// CTA de destaque para o teste de auto-diagnóstico de DTM, usado nas páginas de sintomas.
---
<aside class="vs-diag-cta vs-reveal" aria-label="Teste de auto-diagnóstico de DTM">
  <span class="vs-diag-cta__icon" aria-hidden="true">🩻</span>
  <div class="vs-diag-cta__content">
    <p class="vs-diag-cta__eyebrow">Teste gratuito · 1 minuto</p>
    <h2 class="vs-diag-cta__title">Descubra o seu nível de DTM</h2>
    <p class="vs-diag-cta__text">
      Marque os sintomas que fazem parte da sua rotina e veja na hora se a sua articulação está pedindo ajuda.
    </p>
  </div>
  <a href="/diagnosticos/auto-diagnostico" class="vs-btn vs-btn--primary vs-diag-cta__btn">
    Fazer o teste agora
  </a>
</aside>

<style>
  .vs-diag-cta {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 800px;
    margin-bottom: var(--space-8);
    padding: var(--space-6);
    background: var(--color-amber-subtle);
    border: 2px solid var(--color-amber);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glow);
  }

  .vs-diag-cta__icon {
    font-size: 2.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .vs-diag-cta__content {
    flex: 1;
    min-width: 0;
  }

  .vs-diag-cta__eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: var(--space-1);
  }

  .vs-diag-cta__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .vs-diag-cta__text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .vs-diag-cta__btn {
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .vs-diag-cta {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .vs-diag-cta__icon {
      align-self: center;
    }
  }
</style>
